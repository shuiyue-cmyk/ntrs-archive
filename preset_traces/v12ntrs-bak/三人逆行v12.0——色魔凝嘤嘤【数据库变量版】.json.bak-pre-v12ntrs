 justify-self: center;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n}\n.player-title-box::before,\n.player-title-box::after {\n  content: \"\";\n  font-size: 13px;\n  color: var(--t-dim);\n  opacity: 0.8;\n  animation: twinkle ease-in-out infinite;\n  line-height: 1;\n  background: none;\n}\n.player-title-box::before {\n  content: \"⊹ ࣪ ˖\";\n  animation-duration: 2.4s;\n  animation-delay: 0.1s;\n  margin-right: 2px;\n}\n.player-title-box::after {\n  content: \"˖ ࣪ ⊹\";\n  animation-duration: 2.2s;\n  animation-delay: 0.7s;\n  margin-left: 2px;\n}\n.player-title {\n  display: inline-flex;\n  font-family: inherit;\n  font-size: 13px;\n  font-weight: 400;\n  letter-spacing: 0.12em;\n  line-height: 1.18;\n  white-space: nowrap;\n  color: var(--t-dim);\n}\n.player-arrow {\n  grid-column: 3;\n  justify-self: center;\n  width: 8px;\n  height: 8px;\n  border-right: 1.5px solid var(--t-mute);\n  border-bottom: 1.5px solid var(--t-mute);\n  transform: translateY(-2px) rotate(45deg);\n  opacity: 0.64;\n  transition: transform 0.22s ease, opacity 0.22s ease;\n}\n.starry-player[open] .player-arrow {\n  transform: translateY(2px) rotate(225deg);\n  opacity: 0.9;\n  border-color: var(--t-main);\n}\n.player-body {\n  position: relative;\n  z-index: 1;\n  padding: 0 13px 14px 13px;\n  opacity: 0;\n  transform: translateY(6px);\n  animation: choiceFlyIn 0.35s forwards;\n}\n.stardust-line {\n  text-align: center;\n  font-size: 14px;\n  color: var(--t-mute);\n  margin: 0 0 10px 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n}\n.stardust-line span {\n  display: inline-block;\n  animation: twinkleSoft ease-in-out infinite;\n}\n.stardust-line .dust-left { animation-duration: 2.1s; animation-delay: 0s; }\n.stardust-line .dust-core { animation-duration: 2.8s; animation-delay: 0.45s; font-size: 1.1em; }\n.stardust-line .dust-right { animation-duration: 2.4s; animation-delay: 0.9s; }\n.poem-casket {\n  position: relative;\n  margin-bottom: 12px;\n  padding: 8px 12px;\n  border-radius: 20px;\n  background: color-mix(in srgb, var(--t-main) 5%, transparent);\n  border: 1px solid var(--t-line);\n  transition: border 0.2s ease;\n}\n.poem-casket:hover { border-color: var(--t-mute); }\n.poem-text {\n  font-family: \"STSong\", \"Songti SC\", \"Noto Serif SC\", serif;\n  font-size: 12px;\n  line-height: 1.55;\n  text-align: center;\n  letter-spacing: 0.04em;\n  color: var(--t-dim);\n  white-space: pre-wrap;\n}\n.music-vessel {\n  position: relative;\n  border-radius: 24px;\n  border: 1px solid var(--t-line);\n  padding: 12px 12px 10px;\n  background: color-mix(in srgb, var(--t-main) 4%, transparent);\n  transition: border-color 0.2s;\n}\n.music-vessel:hover { border-color: var(--t-mute); }\n.disc-row {\n  display: grid;\n  grid-template-columns: 56px minmax(0, 1fr) 44px;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 12px;\n}\n.vinyl-star {\n  position: relative;\n  width: 56px;\n  height: 56px;\n  border-radius: 50%;\n  background: radial-gradient(circle at 30% 30%, rgba(255,255,240,0.2), color-mix(in srgb, var(--t-main) 12%, transparent) 70%);\n  box-shadow: 0 0 0 1px var(--t-line), 0 0 0 3px color-mix(in srgb, var(--t-main) 6%, transparent);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.vinyl-star.spinning { animation: vinylSpin 5s linear infinite; }\n.cover-mini {\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  overflow: hidden;\n  background: color-mix(in srgb, var(--t-main) 8%, transparent);\n  border: 1px solid var(--t-line);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.cover-mini img { width: 100%; height: 100%; object-fit: cover; }\n.cover-mini .no-cover { font-size: 12px; color: var(--t-mute); }\n.song-aura { min-width: 0; }\n.song-label {\n  font-size: 9px;\n  letter-spacing: 0.2em;\n  color: var(--t-mute);\n  margin-bottom: 4px;\n  text-transform: uppercase;\n}\n.song-title {\n  font-size: 14px;\n  font-weight: 500;\n  color: var(--t-dim);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.song-artist {\n  font-size: 11px;\n  color: var(--t-mute);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  margin-top: 2px;\n}\n.equalizer {\n  display: flex;\n  align-items: end;\n  gap: 3px;\n  height: 16px;\n  margin-top: 5px;\n  opacity: 0.5;\n}\n.equalizer i {\n  display: block;\n  width: 2.5px;\n  background: var(--t-dim);\n  border-radius: 2px;\n}\n.starry-player.is-playing .equalizer { opacity: 0.9; }\n.starry-player.is-playing .equalizer i { animation: equalizeWave 0.65s ease-in-out infinite; }\n.starry-player.is-playing .equalizer i:nth-child(2) { animation-duration: 0.55s; animation-delay: -0.15s; }\n.starry-player.is-playing .equalizer i:nth-child(3) { animation-duration: 0.7s; animation-delay: -0.3s; }\n.starry-player.is-playing .equalizer i:nth-child(4) { animation-duration: 0.5s; animation-delay: -0.1s; }\n.starry-player.is-playing .equalizer i:nth-child(5) { animation-duration: 0.8s; animation-delay: -0.25s; }\n.play-star-btn {\n  justify-self: center;\n  width: 42px;\n  height: 42px;\n  border-radius: 999px;\n  background: color-mix(in srgb, var(--t-main) 6%, transparent);\n  border: 1px solid var(--t-line);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  color: var(--t-mute);\n  transition: all 0.2s ease;\n}\n.play-star-btn:hover {\n  transform: scale(1.05);\n  border-color: var(--t-main);\n  color: var(--t-main);\n}\n.play-star-btn svg { width: 18px; height: 18px; fill: currentColor; }\n.control-bar {\n  display: grid;\n  grid-template-columns: 36px minmax(0, 1fr) 36px;\n  align-items: center;\n  gap: 8px;\n  margin-top: 8px;\n  margin-bottom: 6px;\n}\n.time-stamp {\n  font-size: 10px;\n  font-variant-numeric: tabular-nums;\n  color: var(--t-mute);\n  text-align: center;\n}\n.slider-starry {\n  width: 100%;\n  height: 16px;\n  background: transparent;\n  -webkit-appearance: none;\n  appearance: none;\n  cursor: pointer;\n}\n.slider-starry::-webkit-slider-runnable-track {\n  height: 4px;\n  border-radius: 4px;\n  background: color-mix(in srgb, var(--t-main) 30%, transparent);\n}\n.slider-starry::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  width: 12px;\n  height: 12px;\n  margin-top: -4px;\n  border-radius: 50%;\n  background: var(--t-main);\n  border: 1px solid color-mix(in srgb, var(--t-main) 40%, white);\n  box-shadow: 0 0 5px var(--t-main);\n  cursor: pointer;\n}\n.slider-starry::-webkit-slider-thumb:hover { transform: scale(1.15); }\n.js-progress {\n  background: linear-gradient(90deg, var(--t-main) 0%, var(--t-main) var(--progress-percent,0%), color-mix(in srgb, var(--t-main) 25%, transparent) var(--progress-percent,0%));\n  background-repeat: no-repeat;\n}\n.volume-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin-top: 8px;\n  padding-top: 4px;\n}\n.volume-icon {\n  font-size: 11px;\n  letter-spacing: 1px;\n  color: var(--t-mute);\n  min-width: 28px;\n}\n.volume-slider { flex: 1; }\n.volume-slider::-webkit-slider-runnable-track { background: color-mix(in srgb, var(--t-main) 40%, transparent); height: 4px; }\n.status-badge {\n  background: color-mix(in srgb, var(--t-main) 5%, transparent);\n  border-radius: 40px;\n  padding: 2px 8px;\n  font-size: 9px;\n  color: var(--t-mute);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  max-width: 105px;\n  text-align: center;\n  border: 0.5px solid var(--t-line);\n}\n.hidden-data { display: none !important; }\n@media (max-width: 600px) {\n  body { padding: 4px 8px; }\n  .player-head { min-height: 36px; padding: 7px 13px; grid-template-columns: 28px minmax(0,1fr) 28px; }\n  .player-title { font-size: 12px; }\n  .disc-row { grid-template-columns: 48px minmax(0,1fr) 38px; gap: 8px; }\n  .vinyl-star { width: 48px; height: 48px; }\n  .cover-mini { width: 38px; height: 38px; }\n  .play-star-btn { width: 36px; h