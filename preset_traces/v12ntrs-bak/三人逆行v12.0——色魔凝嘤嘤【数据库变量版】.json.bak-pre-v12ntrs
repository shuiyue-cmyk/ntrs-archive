pan class=\"time-stamp js-duration\">0:00</span>\n      </div>\n      <div class=\"volume-row\">\n        <span class=\"volume-icon\">⊹ VOL</span>\n        <input type=\"range\" class=\"slider-starry volume-slider js-volume\" min=\"0\" max=\"1\" step=\"0.02\" value=\"0.7\">\n        <div class=\"status-badge js-status-message\">✨ 待奏 ✨</div>\n      </div>\n    </div>\n    <audio class=\"js-audio-player\" preload=\"metadata\"></audio>\n  </div>\n</details>\n<script>\n(function(){\n  // ---------- 辅助函数 ----------\n  function getHiddenData(attr) {\n    var el = document.querySelector('.hidden-data[' + attr + ']');\n    if (!el) return '';\n    var val = el.getAttribute(attr);\n    return (val && !val.startsWith('$')) ? val.trim() : '';\n  }\n\n  // ---------- 主题同步（与父窗口颜色联动） ----------\n  function syncTheme() {\n    try {\n      var w = window.parent || window;\n      var d = w.document;\n      var root = d.documentElement;\n      var body = d.body;\n      var chatEl = d.querySelector('.mes_text') || d.querySelector('#chat') || body;\n      var styles = w.getComputedStyle(root);\n      var chatStyles = w.getComputedStyle(chatEl || body);\n      var bodyStyles = w.getComputedStyle(body || root);\n      var textColor = styles.getPropertyValue('--SmartThemeTextColor').trim();\n      if (!textColor || textColor.indexOf('var(') === 0) {\n        textColor = (chatStyles && chatStyles.color) || (bodyStyles && bodyStyles.color);\n      }\n      document.querySelectorAll('.starry-player').forEach(function(el) {\n        if (textColor && textColor.indexOf('var(') !== 0) {\n          el.style.setProperty('--st-text', textColor);\n        }\n        var ff = (chatStyles && chatStyles.fontFamily) || (bodyStyles && bodyStyles.fontFamily);\n        if (ff) el.style.fontFamily = ff;\n        var fw = styles.getPropertyValue('--mainFontWeight').trim() || (chatStyles && chatStyles.fontWeight) || (bodyStyles && bodyStyles.fontWeight);\n        if (fw) el.style.fontWeight = fw;\n        var fs = styles.getPropertyValue('--mainFontSize').trim() || (chatStyles && chatStyles.fontSize) || (bodyStyles && bodyStyles.fontSize);\n        if (fs) el.style.fontSize = fs;\n      });\n    } catch(e) {}\n  }\n\n  // ---------- iframe 高度自适应 ----------\n  function resizeFrame() {\n    try { var f = window.frameElement; if (f) f.style.height = document.body.scrollHeight + 'px'; } catch(e) {}\n  }\n\n  // ---------- DOM 元素绑定 ----------\n  var container = document.querySelector('.starry-player');\n  var poemDisplay = document.querySelector('.js-poem-display');\n  var trackTitleSpan = document.querySelector('.js-track-title');\n  var trackArtistSpan = document.querySelector('.js-track-artist');\n  var coverMiniDiv = document.querySelector('.js-cover-mini');\n  var vinylDisc = document.querySelector('.js-vinyl');\n  var playBtn = document.querySelector('.js-play-btn');\n  var playIconSvg = document.querySelector('.play-icon');\n  var pauseIconSvg = document.querySelector('.pause-icon');\n  var progressSlider = document.querySelector('.js-progress');\n  var currentTimeSpan = document.querySelector('.js-current-time');\n  var durationSpan = document.querySelector('.js-duration');\n  var volumeSlider = document.querySelector('.js-volume');\n  var statusSpan = document.querySelector('.js-status-message');\n  var audio = document.querySelector('.js-audio-player');\n\n  // ---------- 初始化显示内容 ----------\n  var rawPoem = getHiddenData('data-poem');\n  var rawSongName = getHiddenData('data-song');\n  if (rawPoem) poemDisplay.textContent = rawPoem;\n  else poemDisplay.textContent = '⋆ 星河入梦，弦月如钩 ⋆';\n  if (!rawSongName) rawSongName = 'Stardust Melody';\n  trackTitleSpan.textContent = rawSongName;\n  trackArtistSpan.textContent = '搜索中 · 星轨';\n\n  // ---------- 音乐播放核心（完整保留原有搜索逻辑） ----------\n  var songData = null;\n  var isPlaying = false;\n  var isSearching = false;\n\n  function setStatus(msg) { if (statusSpan) statusSpan.textContent = msg; }\n  function setPlayingUI(flag) {\n    isPlaying = !!flag;\n    if (flag) container.classList.add('is-playing');\n    else container.classList.remove('is-playing');\n    if (vinylDisc) vinylDisc.classList.toggle('spinning', flag);\n    if (playIconSvg && pauseIconSvg) {\n      playIconSvg.style.display = flag ? 'none' : 'block';\n      pauseIconSvg.style.display = flag ? 'block' : 'none';\n    }\n  }\n\n  function formatTime(sec) {\n    if (!isFinite(sec) || isNaN(sec)) return '0:00';\n    var min = Math.floor(sec / 60);\n    var s = Math.floor(sec % 60);\n    return min + ':' + (s < 10 ? '0' : '') + s;\n  }\n\n  function updateProgressFill() {\n    if (!progressSlider || !audio) return;\n    var dur = audio.duration || 0;\n    var cur = audio.currentTime || 0;\n    var percent = dur ? (cur / dur) * 100 : 0;\n    progressSlider.style.setProperty('--progress-percent', percent + '%');\n    progressSlider.value = cur;\n  }\n\n  function waitForMusicAPI() {\n    return new Promise(function(resolve) {\n      var tries = 40;\n      function check() {\n        if (window.Music && typeof window.Music.SearchMusic === 'function') {\n          resolve(true);\n        } else if (--tries <= 0) {\n          resolve(false);\n        } else {\n          setTimeout(check, 120);\n        }\n      }\n      check();\n    });\n  }\n\n  async function searchByBundledApi(name) {\n    try {\n      var ok = await waitForMusicAPI();\n      if (!ok) return null;\n      var res = await window.Music.SearchMusic(name);\n      if (res && res.Url) {\n        return {\n          Url: res.Url,\n          Name: res.Name || name,\n          Singer: res.Singer || res.Artist || '星尘歌手',\n          Cover: res.Cover || res.Pic || ''\n        };\n      }\n      return null;\n    } catch(e) {\n      console.warn('Music.js search error:', e);\n      return null;\n    }\n  }\n\n  async function searchByNeteaseFallback(name) {\n    try {\n      var searchUrl = 'https://music.163.com/api/search/get/web?csrf_token=&s=' + encodeURIComponent(name) + '&ty