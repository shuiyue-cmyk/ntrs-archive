overMiniDiv.appendChild(img);\n        } else {\n          coverMiniDiv.innerHTML = '<div class=\"no-cover\">✨</div>';\n        }\n      }\n\n      if (audio) {\n        audio.src = res.Url;\n        audio.load();\n      }\n      setStatus('♫ 可奏 ♫');\n      return res;\n    } catch(e) {\n      console.error('resolveSong error:', e);\n      setStatus('检索失败');\n      return null;\n    } finally {\n      isSearching = false;\n    }\n  }\n\n  async function onPlayPause() {\n    if (!audio) return;\n    var data = (songData && songData.Url) ? songData : await resolveSong();\n    if (!data || !data.Url) {\n      setStatus('无可用音轨');\n      return;\n    }\n    try {\n      if (isPlaying) {\n        audio.pause();\n        setPlayingUI(false);\n        setStatus('⏸ 暂歇');\n      } else {\n        setStatus('✨ 唤醒星声 ✨');\n        await audio.play();\n        setPlayingUI(true);\n        setStatus('⋆ 星河漫游 ⋆');\n      }\n    } catch(err) {\n      console.warn('play error:', err);\n      setPlayingUI(false);\n      setStatus('点击重试');\n    }\n  }\n\n  // ---------- 事件绑定 ----------\n  if (playBtn) {\n    playBtn.addEventListener('click', function(e) {\n      e.preventDefault();\n      onPlayPause();\n    });\n  }\n\n  if (audio) {\n    audio.addEventListener('timeupdate', function() {\n      if (!progressSlider) return;\n      var cur = audio.currentTime || 0;\n      var dur = audio.duration || 0;\n      progressSlider.max = dur || 100;\n      progressSlider.value = cur;\n      updateProgressFill();\n      if (currentTimeSpan) currentTimeSpan.textContent = formatTime(cur);\n      if (durationSpan && dur) durationSpan.textContent = formatTime(dur);\n    });\n\n    audio.addEventListener('loadedmetadata', function() {\n      if (durationSpan) durationSpan.textContent = formatTime(audio.duration);\n      if (progressSlider) progressSlider.max = audio.duration || 100;\n      updateProgressFill();\n    });\n\n    audio.addEventListener('ended', function() {\n      setPlayingUI(false);\n 