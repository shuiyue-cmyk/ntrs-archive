-columns:1fr;gap:4px;margin:4px 14px 0;padding:3px;background:var(--p-seg-bg);border-radius:999px}\",\n\".pv3-seg button{border:0;background:none;border-radius:999px;padding:6px 0;font-size:12px;color:var(--p-ink2);cursor:pointer;white-space:nowrap;font-weight:600}\",\n\".pv3-seg button.pv3-on{background:var(--p-accent);color:var(--p-btn-ink);font-weight:700;box-shadow:0 1px 3px var(--p-shadow)}\",\n\"#\" + APP_ID + '[data-pv3-tier=\"l\"] .pv3-seg button{font-size:12.5px;padding:7px 0}',\n/* 搜索行 */\n\".pv3-search{flex:none;display:flex;gap:6px;margin:8px 14px 6px;align-items:center}\",\n/* 宽档矮屏（PC 零滚动）：搜索/Discord/双栏起始的竖向留白各收一点，合计省 ~18px */\n\"#\" + APP_ID + '[data-pv3-tier=\"l\"] .pv3-search{margin:5px 14px 3px}',\n\"#\" + APP_ID + '[data-pv3-tier=\"l\"] .pv3-discord{margin:1px 14px 6px;padding:6px 12px}',\n\"#\" + APP_ID + '[data-pv3-tier=\"l\"] .pv3-cols{margin-top:3px}',\n\".pv3-search input{flex:1;min-width:0;border:1px solid var(--p-border);background:var(--p-card);border-radius:12px;padding:6px 10px;font-size:12px;color:var(--p-ink);outline:none}\",\n\".pv3-search input::placeholder{color:var(--p-muted)}\",\n/* 主页容器：窄档=单列值行滚动；宽档（.pv3-navcols）=双栏各自滚动 */\n\".pv3-nav,.pv3-allnav{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;margin:0 8px 4px;padding:0 6px}\",\n\".pv3-nav.pv3-navcols{display:flex;flex-direction:column;overflow:hidden}\",\n/* ── F1 双栏（min-height:0 铁律防撑破 dock；min-width:0 铁律防 track 页宽溢出） ── */\n\".pv3-cols{flex:1;display:flex;min-height:0;min-width:0;margin-top:7px}\",\n/* 左栏宽度：约束是像素下限（窄于 ~280px 拨杆行分类名就截断），不是百分比——\n * 面板宽会被视口钳制（placePanel），按 tier 令牌给百分比会在窄视口下失真 */\n\".pv3-vlist{width:290px;flex:0 1 auto;max-width:55%;min-width:0;overflow-y:auto;overscroll-behavior:contain;padding:0 5px 8px 2px}\",\n/* 伴随窗选择器域：单列一行一条 + 豁免卡还原（原右栏 pane 规则移植；.pv3-side 加层压过 tier 三列规则） */\n\"#\" + APP_ID + \" .pv3-side .pv3-sidebody .pv3-egrid{grid-template-columns:1fr}\",\n\"#\" + APP_ID + \" .pv3-side .pv3-sidebody .pv3-ecard.pv3-exempt{grid-column:auto}\",\n\".pv3-pane{flex:1;min-width:0;overflow-y:auto;overscroll-behavior:contain}\",\n/* 展开态左栏变窄：账本行值轴自然收缩（ellipsis），无需额外规则 */\n\".pv3-cols:not(.pv3-nopane) .pv3-vrow{gap:5px;padding:7px 4px}\",\n/* 右栏收起态：左栏独占整宽；l/m 档两列并排（行已收紧到 31px，m 档 490px 容得下两列），s 档单列 */\n\".pv3-cols.pv3-nopane .pv3-vlist{width:100%;max-width:none;display:grid;grid-template-columns:1fr;gap:0 12px;align-content:start;align-items:start;padding-right:2px}\",\n\"#\" + APP_ID + '[data-pv3-tier=\"l\"] .pv3-cols.pv3-nopane .pv3-vlist{grid-template-columns:repeat(2,minmax(0,1fr))}',\n\"#\" + APP_ID + '[data-pv3-tier=\"m\"] .pv3-cols.pv3-nopane .pv3-vlist{grid-template-columns:repeat(2,minmax(0,1fr));gap:0 8px}',\n/* 区头：色块小标签（固定深墨字）+ 淡线（值行列表/编辑网格共用）\n * 宽档主页收紧上下留白（4 个区头 ×12px = 一整行的高度，是「PC 要零滚动」里最划算的一刀） */\n\".pv3-zh{grid-column:1/-1;display:flex;align-items:center;gap:8px;margin:9px 1px 3px}\",\n\".pv3-cols.pv3-nopane .pv3-zh{margin:4px 1px 1px}\",\n\".pv3-cols.pv3-nopane .pv3-zh:first-child{margin-top:0}\",\n\".pv3-zh b{background:var(--zc,var(--p-muted));color:var(--pv3-chip-ink);border-radius:6px;padding:2px 9px;letter-spacing:.18em;font-size:10px;font-weight:800}\",\n\".pv3-zh .pv3-ln{flex:1;height:1px;background:var(--p-border)}\",\n\".pv3-z0{--zc:#E8A15C}.pv3-z1{--zc:#7FAAD4}.pv3-z2{--zc:#CC7A6E}.pv3-z3{--zc:#9A968C}\",\n/* 移动档四区横向页签：色点+区名，选中=区色下划线+提亮 */\n\".pv3-ztabs{position:sticky;top:0;z-index:1;display:flex;gap:2px;padding:2px 0 0;margin-bottom:2px;background:var(--p-panel)}\",\n\".pv3-ztab{flex:1;display:flex;align-items:center;justify-content:center;gap:5px;border:0;background:none;padding:6px 0;font-size:11.5px;font-weight:700;letter-spacing:.12em;color:var(--p-muted);border-bottom:2px solid var(--p-border);cursor:pointer}\",\n\".pv3-ztab i{width:6px;height:6px;border-radius:2px;background:var(--zc,var(--p-muted));opacity:.65}\",\n\".pv3-ztab.pv3-on{color:var(--p-ink);border-bottom-color:var(--zc,var(--p-accent))}\",\n\".pv3-ztab.pv3-on i{opacity:1}\",\n/* ── F1 值行（分类名+当前值+›；未启用整行调暗；「未选」值弱化） ── */\n\".pv3-vrow{display:flex;align-items:center;gap:6px;width:100%;min-width:0;min-height:36px;padding:7px 6px 7px 8px;border:0;background:none;border-radius:10px;cursor:pointer;text-align:left;color:var(--p-ink)}\",\n/* mob/s 行距收一档（36+14→34+6）：设定区 7 行曾比面板高出一截，页签内出现几十像素的短滑动；\n * 上下 padding 3px——mob 档 28px 控件（larr/lgo）加 4px padding 会把行撑到 36px，设定区多选行×3 就溢出 6px */\n\"#\" + APP_ID + '[data-pv3-tier=\"mob\"] .pv3-nav .pv3-vrow,#' + APP_ID + '[data-pv3-tier=\"s\"] .pv3-nav .pv3-vrow{min-height:34px;padding:3px 6px 3px 8px}',\n/* mob/s 主页行分隔线（::after 压行内，零高度成本——卡片框方案每行+边框+间距会让设定区超高 45px 破零滑动）：\n * 通栏细线两端全落同一竖线，行宽一致一眼可见（裸行观感宽度=内容撑到哪算哪，曾被看成行宽不一）。\n * 字数组两行合一段：线挂 wrap 上，内行不画防双线 */\n\"#\" + APP_ID + '[data-pv3-tier=\"mob\"] .pv3-nav .pv3-vrow,#' + APP_ID + '[data-pv3-tier=\"s\"] .pv3-nav .pv3-vrow,#' + APP_ID + '[data-pv3-tier=\"mob\"] .pv3-nav .pv3-lwcwrap,#' + APP_ID + '[data-pv3-tier=\"s\"] .pv3-nav .pv3-lwcwrap{position:relative}',\n\"#\" + APP_ID + '[data-pv3-tier=\"mob\"] .pv3-nav .pv3-vrow::after,#' + APP_ID + '[data-pv3-tier=\"s\"] .pv3-nav .pv3-vrow::after,#' + APP_ID + '[data-pv3-tier=\"mob\"] .pv3-nav .pv3-lwcwrap::after,#' + APP_ID + '[data-pv3-tier=\"s\"] .pv3-nav .pv3-lwcwrap::after{content:\"\";position:absolute;left:6px;right:6px;bottom:0;height:1px;background:var(--p-border)}',\n\"#\" + APP_ID + '[data-pv3-tier=\"mob\"] .pv3-nav .pv3-lwcwrap .pv3-vrow::after,#' + APP_ID + '[data-pv3-tier=\"s\"] .pv3-nav .pv3-lwcwrap .pv3-vrow::after{display:none}',\n/* 行加宽：主页容器左右缩边（8+6→4+3），配合面板边距收窄（10→8）整行宽 +18px */\n\"#\" + APP_ID + '[data-pv3-tier=\"mob\"] .pv3-nav,#' + APP_ID + '[data-pv3-tier=\"s\"] .pv3-nav{margin:0 4px 4px;padding:0 3px}',\n/* mob/s 主页滚动条不占位：宿主自定义 ::-webkit-scrollbar 占 ~15px 行宽，哪个区竖向溢出（或内联选择器展开）哪个区的行就整体变窄——各区行宽肉眼不齐；触屏拖动不需要滚动条 */\n\"#\" + APP_ID + '[data-pv3-tier=\"mob\"] .pv3-nav,#' + APP_ID + '[data-pv3-tier=\"s\"] .pv3-nav{scrollbar-width:none}',\n\"#\" + APP_ID + '[data-pv3-tier=\"mob\"] .pv3-nav::-webkit-scrollbar,#' + APP_ID + '[data-pv3-tier=\"s\"] .pv3-nav::-webkit-scrollbar{display:none;width:0;height:0}',\n/* 宽档主页（鼠标操作，不需要 44px 触控靶）收紧行高：36→31px，12 行省 60px；移动/窄档保持原尺寸 */\n\".pv3-cols.pv3-nopane .pv3-vrow{min-height:31px;padding:4px 6px 4px 8px}\",\n\".pv3-vrow:hover{background:var(--p-hover)}\",\n\".pv3-vrow.pv3-on{background:var(--p-soft);box-shadow:inset 0 0 0 1px var(--p-accent)}\",\n\".pv3-vrow.pv3-vdim{opacity:.55}\",\n\".pv3-vic{flex:none;font-size:12px;width:17px;text-align:center;line-height:1}\",\n/* ── v6.2 四轴账本行（全档统一）：名字轴/值轴(左对齐)/徽章轴/控件轴四条竖线全行对齐。\n * 控件轴=两槽制：可拨行「‹ ›」占两槽，钻取行「›」只占右槽——所有 › 同一竖线 */\n\".pv3-lrow{gap:6px}\",\n\".pv3-lfill{flex:1;min-width:0}\",\n\".pv3-lstyle{min-width:0}\",\n\".pv3-lnm{flex:none;width:68px;font-size:var(--pv3-fs-vnm);font-weight:600;color:var(--p-ink2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;border:0;background:none;padding:0;cursor:pointer;text-align:left;font-family:inherit}\",\n\".pv3-lnm:hover{color:var(--p-accent-text)}\",\n\".pv3-lval{flex:1;min-width:0;font-size:var(--pv3-fs-vval);font-weight:700;color:var(--p-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:left}\",\n\".pv3-lval.pv3-off{color:var(--p-muted);font-weight:450}\",\n/* 徽章轴：×N 总数直读；无徽章行占位隐形（保控件轴不漂移）；定宽盒（min-width 随位数漂 1~2px，锁死） */\n\".pv3-lbdg{flex:none;width:34px;text-align:center;font-size:10.5px;font-weight:700;color:var(--p-accent-text);background:var(--p-soft);border-radius:999px;padding:1.5px 0;font-variant-numeric:tabular-nums;overflow:hidden}\",\n\".pv3-lbdg.pv3-lbdg0{visibility:hidden}\",\n/* 展开钮 ▾/▴（文风子组浏览）：落在徽章轴同列（同宽 34px） */\n\".pv3-lexp{flex:none;width:34px;height:22px;border:0;background:none;color:var(--p-muted);font-size:10px;cursor:pointer;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;padding:0}\",\n\".pv3-lexp:hover{background:var(--p-soft);color:var(--p-accent-text)}\",\n/* 控件轴：裸「‹ ›」箭头（无描边无底常显）；钻取 › 同槽同位同级——曾比箭头淡小一档，多选行右缘失重，观感上比拨杆行窄 */\n\".pv3-lctl{flex:none;display:inline-flex;align-items:center;gap:2px}\",\n\".pv3-larr{flex:none;width:24px;height:24px;border:0;background:none;color:var(--p-ink2);font-size:14px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;padding:0;border-radius:8px;line-height:1}\",\n\".pv3-larr:hover{background:var(--p-soft);color:var(--p-accent-text)}\",\n\".pv3-larr:active{transform:scale(.88)}\",\n\".pv3-lslot{flex:none;width:24px;height:24px}\",\n\".pv3-lgo{flex:none;width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;color:var(--p-ink2);font-size:14px;font-weight:700;font-style:normal}\",\n\".pv3-vrow:hover .pv3-lgo{color:var(--p-accent-text)}\",\n/* m 档两列更挤：名字轴/图标/箭头各收一档，保值轴 ≥60px */\n\"#\" + APP_ID + '[data-pv3-tier=\"m\"] .pv3-cols.pv3-nopane .pv3-vrow{gap:4px;padding:4px 3px 4px 5px}',\n\"#\" + APP_ID + '[data-pv3-tier=\"m\"] .pv3-cols.pv3-nopane .pv3-vic{width:14px;font-size:11px}',\n\"#\" + APP_ID + '[data-pv3-tier=\"m\"] .pv3-lnm{width:56px}',\n\"#\" + APP_ID + '[data-pv3-tier=\"m\"] .pv3-larr,#' + APP_ID + '[data-pv3-tier=\"m\"] .pv3-lslot,#' + APP_ID + '[data-pv3-tier=\"m\"] .pv3-lgo{width:22px;height:22px}',\n\"#\" + APP_ID + '[data-pv3-tier=\"m\"] .pv3-larr,#' + APP_ID + '[data-pv3-tier=\"m\"] .pv3-lgo{font-size:13px}',\n/* 字数行（语言字数右邻格）：数字盘裸箭头 + 下行三段器；非定数档数字盘灰化占位不消失（几何恒定）\n * 组高≈两行 → 跨两个行轨（span 2），知识增强自动补进语言字数下方，左列不留空位 */\n\".pv3-lwcwrap{min-width:0}\",\n\"#\" + APP_ID + '[data-pv3-tier=\"l\"] .pv3-cols.pv3-nopane .pv3-vlist > .pv3-lwcwrap{grid-row:span 2}',\n\".pv3-lwcseg{display:flex;justify-content:flex-end;padding:0 6px 2px 30px;margin-top:-2px}\",\n/* m 档列窄（~240px）放不下四箭头双数字盘：字数组退化为整行跨列 */\n\"#\" + APP_ID + '[data-pv3-tier=\"m\"] .pv3-lwcwrap{grid-column:1/-1;grid-row:auto}',\n/* mob 档：数字盘整行禁折（箭头/数字/间距各收一档），三段器紧贴其下（与知识增强之间不留大空档） */\n\"#\" + APP_ID + '[data-pv3-tier=\"mob\"] .pv3-lwcwrap .pv3-vrow{flex-wrap:nowrap;min-height:34px;padding:4px 2px}',\n\"#\" + APP_ID + '[data-pv3-tier=\"mob\"] .pv3-lwcwrap .pv3-larr{width:24px;height:26px;font-size:13px}'