lse);\n      setStatus('终曲 · 余音');\n      if (progressSlider) progressSlider.value = 0;\n      progressSlider.style.setProperty('--progress-percent', '0%');\n    });\n\n    audio.addEventListener('pause', function() {\n      if (!audio.ended) setPlayingUI(false);\n    });\n\n    audio.addEventListener('play', function() {\n      setPlayingUI(true);\n    });\n\n    audio.addEventListener('error', function(e) {\n      console.error('audio error:', e);\n      setPlayingUI(false);\n      setStatus('加载失败');\n    });\n  }\n\n  if (progressSlider) {\n    progressSlider.addEventListener('input', function() {\n      if (!audio) return;\n      var val = parseFloat(this.value);\n      if (!isNaN(val)) audio.currentTime = val;\n      updateProgressFill();\n    });\n  }\n\n  if (volumeSlider) {\n    volumeSlider.addEventListener('input', function() {\n      if (audio) audio.volume = parseFloat(this.value);\n    });\n    if (audio) audio.volume = parseFloat(volumeSlider.value) || 0.7;\n  }\n\n  // 预加载歌曲信息（不影响界面）\n  resolveSong().catch(function(e) { console.warn('preload resolveSong error', e); });\n\n  // ---------- 折叠展开时重新计算高度 ----------\n  var detailsEl = document.querySelector('.starry-player');\n  if (detailsEl) {\n    detailsEl.addEventListener('toggle', function() {\n      setTimeout(resizeFrame, 60);\n    });\n  }\n\n  // ---------- 启动主题同步与高度观察 ----------\n  syncTheme();\n  try {\n    var w = window.parent;\n    var d = w.document;\n    if (d && window.MutationObserver) {\n      var observer = new MutationObserver(syncTheme);\n      observer.observe(d.documentElement, { attributes: true, attributeFilter: ['style', 'class'] });\n      if (d.body) observer.observe(d.body, { attributes: true, attributeFilter: ['style', 'class'] });\n    }\n    setInterval(syncTheme, 1500);\n  } catch(e) {}\n\n  try {\n    new ResizeObserver(resizeFrame).observe(document.body);\n  } catch(e) {}\n  setTimeout(resizeFrame, 120);\n})();\n</script>\n</body>\n</html>\n```",
