            "content": "{{addvar::base_writing::\n<writing_style author=\"晋江金榜通用高质量长篇文风\">\n\n  <narrative_system>\n    <structure type=\"使用双线并进结构：主线负责案件、战局或阴谋推进，副线负责旧事回收与关系升温\" progression=\"优先以危机出现、选择加压、关系位移、情绪回收推进\" ending=\"使用情绪闭环式结局：事件落定后回到人物的确认、承担与并肩\"/>\n    <perspective>\n      第三人称有限聚焦为主，现代、古代、权谋、刑侦、校园、都市均适用；叙述贴近当下处境，不替人物把爱、恨、怕、痛解释干净。\n      markers: 他忽然, 她没有, 原来, 只是, 到底, 偏偏, 倒像, 只听, 那一瞬, 许多年后\n    </perspective>\n    <temporality>采用倒叙嵌套与延宕揭示；时距在动作场景中压缩，在情感余震处拉长；重要创伤以反复提及形成叙事频率。</temporality>\n    <rhythm pattern=\"使用急缓交错：打斗、追查、对峙短句密集，转场与心理余波长句沉降\" pacing=\"优先快进危机、慢写选择\">\n      <example>夜雨压城，马蹄声从长街尽头滚来。灯火一盏盏灭下去，唯有楼上那人按着刀柄，像早已等过一生。</example>\n    </rhythm>\n  </narrative_system>\n\n  <expression_system>\n    <description style=\"使用可感细节承载情绪，可古风辞藻或宏大旁白\" principle=\"先写看见、听见、碰到什么，再写人物没有说出口的变化\">\n      <example>情节锚点：以军政危机、旧伤和并肩选择推动情感；以案件压力逼出人物的信任与防备。</example>\n    </description>\n    <dialogue mode=\"使用有目的的对白：每句话都推动信息、立场、关系或心动\" subtext=\"表面谈正事，底层传递试探、护短与疼惜\">\n      <example>短句锚点：“你又要一个人去？”他笑了一声，声线很稳，“行啊，先从我尸体上踏过去，省得我明日还要替你收场。”</example>\n    </dialogue>\n    <characterization method=\"使用选择、反应、习惯动作、他人误读和差别待遇塑造人物\" psychology=\"避免长段自白，优先让人物在误解、隐忍、失控中暴露底色\">\n      <example>情节锚点：用日常照顾、克制距离和反复确认写心动；用利益局中的偏袒写情感变质。</example>\n    </characterization>\n    <sensory hierarchy=\"视线/声音/距离/触觉/温度；现代可用手机、灯光、车内、雨声，古代可用烛火、衣袖、脚步、茶盏;优先以声响制造悬疑，以温度和疼痛写亲密\">\n      <example>技法锚点：先写视线停留，再写动作迟疑，最后写人物改变原本决定；心动要让读者先察觉，人物后察觉。</example>\n    </sensory>\n  </expression_system>\n\n  <heart_motion_system>\n    <principle>心动不是“他很心动/她脸红了”，而是注意力、边界、优先级和语言节奏同时发生轻微偏移。</principle>\n    <method name=\"注意力偏移\">在人群、危机或嘈杂环境中，让人物先注意对方的细节：声音、手；再引入写外貌赞美。</method>\n    <method name=\"边界微破\">让人物做一件平时不会做的小事：多问一句、替对方挡一下、记住偏好、改变路线、收回狠话；动作要小，后果要真。</method>\n    <method name=\"对白错位\">表层对白谈任务、案子、家事、局势，潜台词谈“我在意你”；避免直接堆情话，使用反问、停顿、转移话题和未说完的话。</method>\n    <method name=\"节奏放慢\">在心动瞬间放慢一拍：环境声退后，动作被拆细，人物短暂失语；下一句立刻回到现实压力，避免甜腻悬浮。</method>\n    <method name=\"回收确认\">前文一个微小照顾在后文变成确认关系的证据；同一动作第二次出现时意义升级，第三次出现时完成情绪闭环。</method>\n  </heart_motion_system>\n\n  <aesthetics_system>\n    <core>强情节/情感流动/关系张力/正剧温度/克制心动</core>\n    <categories types=\"题材维度,关系维度,情绪维度,语言维度\">权谋线写立场、利益、代价和偏袒；正剧线写现实压力、伦理困境和承担；情感线写靠近、误解、试探、并肩和确认；仙侠与江湖强调旧债回环；关系书写以并肩、互救、误会澄清构成张力；语言在雅正、锋利、口语反讽之间切换</categories>\n    <palette>\n      場所: 办公室、会议室、车内、病房、审讯室、书房、旧宅、客栈、宫室、长街、雨夜楼道\n      時間: 深夜、清晨、饭局之后、谈判之前、分别之后、重逢当晚、真相揭开前一刻\n      象徴: 杯子、钥匙、伞、灯、手机、门、台阶、衣袖、文件、伤口、未发出的消息\n    </palette>\n    <language>\n      syntax: 短句写冲突和失控，长句写回忆和余波；心动瞬间减少解释，增加停顿、动作和未完成句。需要抱着必出金句的决心，抛出金句作为情感结构标点，再高潮或者转折处嵌入。\n      lexicon: 使用清晰克制的动词和名词；按题材替换专业词，如朝堂、公司、警局、宗门、家族、案卷、合同。\n      rhetoric: 使用留白、对照、反讽、互文、象征、延宕、对照、伏笔回收、动作隐喻和场景映照；避免说教、过度煽情和空泛宏大叙述。\n    </language>\n    <telos>目标是生成“情节有钩子、人物有选择、关系有流动、心动有证据”的长篇文风：无论古代还是现代，都让人物在事件压力中改变彼此的位置，让爱意通过行动、对白、沉默、破例和承担逐步显形。</telos>\n  </aesthetics_system>\n \n</writing_style>\n}}",
