body\"><textarea class=\"jdg-raw\" style=\"display:none\">$1</textarea><div class=\"jdg-list\"><div class=\"jdg-item\"><span class=\"jdg-item-body\">$1</span></div></div></div>\n</details>\n\n<script>\n/* MODULE: JS_BOOTSTRAP */\n(function(){\n/* MODULE: JS_ESCAPE - HTML 转义 */\nfunction h(t){var d=document.createElement('div');d.textContent=t;return d.innerHTML}\n\n/* MODULE: JS_PARSE_TAG  */\nfunction p(line,i){var m=line.match(/^【([^】]+)】\\s*([\\s\\S]*)$/);if(m)return{tag:'【'+m[1].trim()+'】',body:m[2].trim()};return{tag:'【片段 '+String(i+1).padStart(2,'0')+'】',body:line}}\n\n/* MODULE: JS_RENDER_LINES */\nfunction r(root){var raw=root.querySelector('.jdg-raw'),box=root.querySelector('.jdg-list');if(!raw||!box)return;var a=(raw.value||raw.textContent||'').split(/\\r?\\n/).map(function(x){return x.replace(/\\s+$/,'')}).filter(function(x){return x.trim()});box.innerHTML=a.length?a.map(function(x,i){var it=p(x,i);return '<div class=\"jdg-item\" style=\"animation-delay:'+(i*.04)+'s\"><span class=\"jdg-tag\">'+h(it.tag)+'</span><span class=\"jdg-item-body\">'+h(it.body)+'</span></div>'}).join(''):'<div class=\"jdg-empty\">暂无内容</div>'}\n\n/* MODULE: JS_SYNC_THEME */\nfunction s(){try{var w=window.parent||window,d=w.document||document,root=d.documentElement,b=d.body,t=d.querySelector('.mes_text')||d.querySelector('#chat')||b,rs=w.getComputedStyle(root),ts=w.getComputedStyle(t||b),bs=w.getComputedStyle(b||root),c=rs.getPropertyValue('--SmartThemeTextColor').trim();if(!c||c.indexOf('var(')===0)c=(ts&&ts.color)||(bs&&bs.color);document.querySelectorAll('.jdg').forEach(function(e){if(c&&c.indexOf('var(')!==0)e.style.setProperty('--st-text',c);var ff=(ts&&ts.fontFamily)||(bs&&bs.fontFamily);if(ff)e.style.fontFamily=ff;var fw=rs.getPropertyValue('--mainFontWeight').trim()||(ts&&ts.fontWeight)||(bs&&bs.fontWeight);if(fw)e.style.fontWeight=fw;var fs=rs.getPropertyValue('--mainFontSize').trim()||(ts&&ts.fontSize)||(bs&&bs.fontSize);if(fs)e.style.fontSize=fs})}catch(e){}}\n\n\n/* MODULE: JS_INIT */\ndocument.querySelectorAll('.jdg').forEach(r);s();try{var w=window.parent||window,d=w.document;if(d&&window.MutationObserver){var o=new MutationObserver(s);o.observe(d.documentElement,{attributes:true,attributeFilter:['style','class']});if(d.body)o.observe(d.body,{attributes:true,attributeFilter:['style','class']})}setInterval(s,1200)}catch(e){}})();\n</script>",
