{
  "id": "47c79f38-eade-477d-b444-a021a467ad6e",
  "scriptName": "Cirno花火台本美化",
  "findRegex": "/(^\\s*(?:(?:以下|以上)是用户的本轮输入|<(?:用户本轮输入|User_Input|本轮用户输入)>)[\\s\\S]*$)/mi",
  "replaceString": "```html\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n:root {\n  --bg-panel: #fff; --bg-card: #f6f5fb; --border: #e6e2f0; --accent: #7c5cff;\n  --text-m: #2c3e50; --text-s: #7f8c8d; --bg-tag: rgba(124,92,255,0.12);\n  --blur: none; --base-fs: 13px; --content-h: 560px;\n  --r1: 14px; --r2: 10px; --r3: 6px; --r-btn: 6px; --border-w: 1px;\n  --accent-2: #ff6b9d; --ok: #2e8b57; --warn: #e67e22; --danger: #c0392b;\n}\n* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }\nhtml, body { margin: 0; padding: 0; background: transparent; }\nbody { font-family: -apple-system, \"PingFang SC\", \"Microsoft YaHei\", sans-serif; font-size: var(--base-fs); color: var(--text-m); }\n#time-capsule { display: none !important; }\n#main-app {\n  background: var(--bg-panel); backdrop-filter: var(--blur); -webkit-backdrop-filter: var(--blur);\n  border: var(--border-w) solid var(--border); border-radius: var(--r1); overflow: hidden;\n  margin: 4px 0; position: relative; color: var(--text-m);\n}\n#main-app.has-input { padding: 6px 4px 4px; }\n#user-input-display {\n  padding: 6px 10px 10px; line-height: 1.55; display: none; font-weight: 500;\n  white-space: pre-wrap; word-break: break-word;\n}\n/* 普通 User_Input：正常电视机信号（稳定） */\n#user-input-display.crt-signal {\n  position: relative;\n  padding: 8px 12px 10px;\n  border-radius: 8px;\n  border: 1px solid rgba(100, 160, 220, 0.28);\n  background:\n    linear-gradient(180deg, rgba(30, 70, 110, 0.08), rgba(20, 40, 60, 0.04)),\n    var(--bg-card, #f6f5fb);\n  color: var(--text-m);\n  text-shadow: 0 0 0.5px rgba(140, 200, 255, 0.25);\n  overflow: hidden;\n  animation: cirnoCrtStable 4.5s ease-in-out infinite;\n}\n#user-input-display.crt-signal::before {\n  content: \"\";\n  pointer-events: none;\n  position: absolute;\n  inset: 0;\n  background: repeating-linear-gradient(\n    to bottom,\n    rgba(0, 0, 0, 0.045) 0px,\n    rgba(0, 0, 0, 0.045) 1px,\n    transparent 1px,\n    transparent 3px\n  );\n  opacity: 0.4;\n  mix-blend-mode: multiply;\n}\n#user-input-display.crt-signal::after {\n  content: \"正常信号\";\n  pointer-events: none;\n  position: absolute;\n  top: 4px;\n  right: 8px;\n  font-size: 0.65em;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  color: rgba(70, 130, 190, 0.7);\n  opacity: 0.8;\n}\n#main-app.has-signal #user-input-display.crt-signal {\n  box-shadow:\n    inset 0 0 14px rgba(80, 140, 200, 0.08),\n    0 0 0 1px rgba(100, 160, 220, 0.08);\n}\n@keyframes cirnoCrtStable {\n  0%, 100% { filter: brightness(1) contrast(1); }\n  50% { filter: brightness(1.02) contrast(1.01); }\n}\n@media (prefers-reduced-motion: reduce) {\n  #user-input-display.crt-signal {\n    animation: none !important;\n  }\n}\n/* revise userCalib：电视 CRT 闪烁感 */\n#user-input-display.crt-flicker {\n  position: relative;\n  padding: 8px 12px 10px;\n  border-radius: 8px;\n  border: 1px solid rgba(120, 200, 255, 0.35);\n  background:\n    linear-gradient(180deg, rgba(40, 90, 70, 0.12), rgba(20, 40, 50, 0.08)),\n    var(--bg-card, #f6f5fb);\n  color: var(--text-m);\n  text-shadow: 0 0 1px rgba(120, 255, 180, 0.35);\n  animation: cirnoCrtFlicker 2.4s infinite;\n  overflow: hidden;\n}\n#user-input-display.crt-flicker::before {\n  content: \"\";\n  pointer-events: none;\n  position: absolute;\n  inset: 0;\n  background: repeating-linear-gradient(\n    to bottom,\n    rgba(0, 0, 0, 0.08) 0px,\n    rgba(0, 0, 0, 0.08) 1px,\n    transparent 1px,\n    transparent 3px\n  );\n  opacity: 0.55;\n  mix-blend-mode: multiply;\n  animation: cirnoCrtScan 6s linear infinite;\n}\n#user-input-display.crt-flicker::after {\n  content: \"校准信号\";\n  pointer-events: none;\n  position: absolute;\n  top: 4px;\n  right: 8px;\n  font-size: 0.65em;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  color: rgba(80, 160, 120, 0.75);\n  opacity: 0.85;\n  animation: cirnoCrtBadge 1.6s ease-in-out infinite;\n}\n#main-app.has-calib #user-input-display.crt-flicker {\n  box-shadow:\n    inset 0 0 18px rgba(60, 180, 120, 0.12),\n    0 0 0 1px rgba(100, 200, 160, 0.12);\n}\n@keyframes cirnoCrtFlicker {\n  0%   { filter: brightness(1) contrast(1); opacity: 1; }\n  7%   { filter: brightness(1.08) contrast(1.05); opacity: 0.92; }\n  8%   { filter: brightness(0.82) contrast(1.15); opacity: 0.78; }\n  10%  { filter: brightness(1.12) contrast(1.02); opacity: 1; }\n  42%  { filter: brightness(1) contrast(1); opacity: 0.97; }\n  43%  { filter: brightness(0.7) contrast(1.2); opacity: 0.7; }\n  45%  { filter: brightness(1.05) contrast(1.05); opacity: 1; }\n  78%  { filter: brightness(1.02) contrast(1); opacity: 0.98; }\n  79%  { filter: brightness(0.88) contrast(1.1) saturate(1.1); opacity: 0.85; }\n  81%  { filter: brightness(1.1) contrast(1.05); opacity: 1; }\n  100% { filter: brightness(1) contrast(1); opacity: 1; }\n}\n@keyframes cirnoCrtScan {\n  0%   { transform: translateY(0); opacity: 0.45; }\n  50%  { opacity: 0.65; }\n  100% { transform: translateY(3px); opacity: 0.45; }\n}\n@keyframes cirnoCrtBadge {\n  0%, 100% { opacity: 0.55; }\n  50% { opacity: 0.95; }\n}\n@media (prefers-reduced-motion: reduce) {\n  #user-input-display.crt-flicker,\n  #user-input-display.crt-flicker::before,\n  #user-input-display.crt-flicker::after {\n    animation: none !important;\n  }\n}\n.inner-card { border-radius: var(--r2); overflow: hidden; }\n#main-app.has-input .inner-card {\n  background: var(--bg-panel); border: var(--border-w) solid var(--border);\n  box-shadow: 0 2px 8px rgba(0,0,0,.03);\n}\ndetails summary { list-style: none !important; cursor: pointer; user-select: none; }\ndetails summary::-webkit-details-marker { display: none !important; }\ndetails summary::marker { content: none !important; display: none !important; }\ndetails.main-fold > summary.main-head {\n  padding: 10px 12px; display: flex; align-items: center; justify-content: space-between; gap: 8px;\n  border-bottom: 1px solid transparent;\n}\ndetails.main-fold[open] > summary.main-head { border-bottom-color: var(--border); }\n.header-left { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }\n.header-title { font-weight: 800; color: var(--accent); font-size: .95em; letter-spacing: .4px; display: flex; align-items: center; gap: 6px; }\n.header-sub { font-size: .75em; color: var(--text-s); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.header-badges { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 3px; }\n.badge { display: inline-flex; align-items: center; padding: 1px 7px; border-radius: 999px; font-size: .72em; font-weight: 700; background: var(--bg-tag); color: var(--accent); }\n.badge.empty { opacity: .45; font-weight: 600; }\n.badge.spawn { background: rgba(230,126,34,.15); color: var(--warn); }\n.badge.no-act { background: rgba(127,140,141,.15); color: var(--text-s); }\n.badge.act { background: rgba(192,57,43,.15); color: var(--danger); }\n/* 台本不完整警示 */\n.badge.warn {\n  background: rgba(230, 126, 34, 0.18);\n  color: #d35400;\n  border: 1px solid rgba(230, 126, 34, 0.35);\n  animation: cirnoWarnPulse 1.4s ease-in-out infinite;\n}\n.header-warn {\n  color: #d35400;\n  font-weight: 700;\n  white-space: normal;\n  line-height: 1.35;\n}\n#main-app.need-rerun .header-title {\n  color: #d35400;\n}\n#main-app.need-rerun .header-title::after {\n  content: \" · 不完整\";\n  font-size: 0.78em;\n  font-weight: 700;\n  opacity: 0.9;\n}\n@keyframes cirnoWarnPulse {\n  0%, 100% { opacity: 0.85; filter: brightness(1); }\n  50% { opacity: 1; filter: brightness(1.08); }\n}\n@media (prefers-reduced-motion: reduce) {\n  .badge.warn { animation: none !important; }\n}\n.badge.ok { background: rgba(46,139,87,.15); color: var(--ok); }\n.controls-wrapper { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }\n.menu-items { display: flex; gap: 4px; max-width: 0; opacity: 0; overflow: hidden; transition: .3s ease; pointer-events: none; }\n.controls-wrapper.open .menu-items { max-width: 200px; opacity: 1; pointer-events: auto; }\n.theme-btn { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; border: none; background: transparent; padding: 0; flex-shrink: 0; }\n.theme-btn-inner { width: 24px; height: 24px; border-radius: var(--r-btn); background: var(--bg-card); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 12px; color: var(--accent); }\n.main-chev { display: inline-block; width: 16px; color: var(--text-s); font-size: 11px; transition: transform .2s; flex-shrink: 0; line-height: 1; }\ndetails.main-fold[open] > summary .main-chev { transform: rotate(90deg); color: var(--accent); }\n.main-body { padding: 10px 12px 14px; }\n#render-target { max-height: var(--content-h); overflow-y: auto; display: flex; flex-direction: column; gap: 8px; min-height: 0; }\n#render-target::-webkit-scrollbar { width: 4px; }\n#render-target::-webkit-scrollbar-thumb { background: rgba(128,128,128,.25); border-radius: 10px; }\ndetails.sec, details.sub-sec { background: var(--bg-card); border: var(--border-w) solid var(--border); border-radius: var(--r2); overflow: hidden; }\ndetails.sub-sec { background: var(--bg-panel); border-radius: var(--r3); }\ndetails.sec > summary.sec-head, details.sub-sec > summary.sec-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 9px 12px; }\ndetails.sub-sec > summary.sec-head { padding: 8px 10px; }\n.sec-title { font-weight: 700; font-size: .88em; color: var(--accent); display: flex; align-items: center; gap: 6px; min-width: 0; }\ndetails.sub-sec .sec-title { font-size: .84em; }\n.sec-title .ico { flex-shrink: 0; line-height: 1; }\n.sec-meta { font-size: .72em; color: var(--text-s); flex-shrink: 0; display: inline-flex; align-items: center; gap: 6px; max-width: 50%; overflow: hidden; }\n.sec-chev { display: inline-block; font-size: 10px; color: var(--text-s); transition: transform .2s; flex-shrink: 0; line-height: 1; }\ndetails.sec[open] > summary .sec-chev, details.sub-sec[open] > summary .sec-chev { transform: rotate(90deg); color: var(--accent); }\n.sec-body { padding: 0 12px 12px; border-top: 1px dashed var(--border); }\ndetails.sec[open] > .sec-body, details.sub-sec[open] > .sec-body { padding-top: 10px; }\ndetails.sub-sec .sec-body { padding-left: 10px; padding-right: 10px; padding-bottom: 10px; }\ndetails.sub-sec[open] > .sec-body { padding-top: 8px; }\n.sub-grid, .thug-people { display: flex; flex-direction: column; gap: 8px; }\n/* 滚动策略 v2：\n   - 时间泛起涟漪 / 黄毛刷新·行动：内容区限高可滚（表多/字段多时）\n   - 花火的盛大演出台本外层不限高，一次露出 导演介绍+导演批评\n   - 仅 导演介绍 / 导演批评 各自内容区可滚\n   - 黄毛人名卡本身不限高，随外层黄毛区一起滚 */\ndetails.sec > .sec-body {\n  max-height: min(380px, 55vh);\n  overflow-y: auto !important;\n  overflow-x: hidden;\n  -webkit-overflow-scrolling: touch;\n  overscroll-behavior: contain;\n}\ndetails.sec > .sec-body::-webkit-scrollbar { width: 4px; }\ndetails.sec > .sec-body::-webkit-scrollbar-thumb {\n  background: rgba(128,128,128,.35); border-radius: 10px;\n}\n/* 演出台本（内含 .sub-grid）外层不滚动 */\ndetails.sec.stage-sec > .sec-body,\ndetails.sec:has(> .sec-body > .sub-grid) > .sec-body {\n  max-height: none !important;\n  overflow: visible !important;\n}\n/* 仅演出台本下的二级：导演介绍 / 导演批评 */\n.sub-grid > details.sub-sec > .sec-body {\n  max-height: min(320px, 45vh);\n  overflow-y: auto !important;\n  overflow-x: hidden;\n  -webkit-overflow-scrolling: touch;\n  overscroll-behavior: contain;\n}\n.sub-grid > details.sub-sec > .sec-body::-webkit-scrollbar { width: 4px; }\n.sub-grid > details.sub-sec > .sec-body::-webkit-scrollbar-thumb {\n  background: rgba(128,128,128,.35); border-radius: 10px;\n}\n/* 黄毛人名卡：不单独限高，交给外层黄毛区滚动 */\n.thug-people details.sub-sec > .sec-body {\n  max-height: none !important;\n  overflow: visible !important;\n}\n.sub-grid { min-height: 0; display: flex; flex-direction: column; gap: 8px; }\n.thug-people { margin-top: 4px; min-height: 0; }\n.thug-target-list { display: flex; flex-direction: column; gap: 4px; margin-top: 6px; padding-left: 4px; }\n.thug-target-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 3px 8px; border-radius: 6px; background: var(--bg-card); border: 1px solid var(--border); }\n.thug-target-name { font-size: .82em; font-weight: 600; color: var(--accent); word-break: break-word; }\n.thug-track-detail { font-size: .8em; margin-top: 4px; }\n.thug-target-label { font-size: .72em; font-weight: 600; color: var(--text-s); background: rgba(124,92,255,.08); padding: 1px 6px; border-radius: 999px; }\n.thug-track-detail > summary { cursor: pointer; color: var(--text-s); font-weight: 600; padding: 2px 0; }\n.thug-track-detail[open] > summary { color: var(--accent); }\n.am-table { width: 100%; }\n/* 黄毛名称栏内联行动状态（与名称并列） */\n.action-inline {\n  display: inline-flex; align-items: center;\n  padding: 1px 7px; border-radius: 999px;\n  font-size: .72em; font-weight: 700; line-height: 1.3;\n  border: 1px solid var(--border); background: var(--bg-panel);\n  flex-shrink: 0; white-space: nowrap;\n}\n.action-inline.no-act { color: var(--text-s); }\n.action-inline.act {\n  color: var(--danger);\n  background: rgba(192,57,43,.08);\n  border-color: rgba(192,57,43,.25);\n}\n.thug-action-fallback { margin-top: 6px; }\n.sec-meta .action-inline { margin-left: 2px; }\n.empty-hint { font-size: .82em; color: var(--text-s); opacity: .85; padding: 8px 4px; font-style: italic; line-height: 1.5; }\n.am-table { width: 100%; border-collapse: collapse; font-size: .86em; }\n.am-table th, .am-table td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }\n.am-table th { color: var(--text-s); font-weight: 700; font-size: .78em; }\n.am-time.is-unclear, tr.am-row-unclear .am-time {\n  color: var(--warn);\n  font-weight: 700;\n}\ntr.am-row-unclear {\n  background: rgba(230,126,34,.06);\n}\n.recall-unclear-hint {\n  margin: 0 0 8px;\n  padding: 6px 10px;\n  border-radius: 8px;\n  font-size: .82em;\n  font-weight: 700;\n  color: var(--warn);\n  background: rgba(230,126,34,.1);\n  border: 1px solid rgba(230,126,34,.28);\n  line-height: 1.4;\n}\n.am-table tr:last-child td { border-bottom: none; }\n.am-code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-weight: 700; color: var(--accent); background: var(--bg-tag); padding: 1px 6px; border-radius: 6px; font-size: .92em; }\n.am-time { color: var(--text-s); white-space: nowrap; }\n.now-line { font-size: .8em; color: var(--text-s); margin-bottom: 8px; padding: 5px 8px; background: var(--bg-panel); border-radius: var(--r3); border: 1px dashed var(--border); }\n.kv-list { display: flex; flex-direction: column; gap: 6px; }\n.kv-row { display: grid; grid-template-columns: 92px 1fr; gap: 8px; padding: 7px 9px; background: var(--bg-panel); border-radius: var(--r3); border: 1px solid var(--border); }\n@media (max-width: 420px) { .kv-row { grid-template-columns: 1fr; gap: 2px; } }\n.kv-k { font-size: .78em; font-weight: 700; color: var(--accent); line-height: 1.4; }\n.kv-v { font-size: .86em; line-height: 1.5; white-space: pre-wrap; word-break: break-word; }\n.spawn-status { display: inline-flex; margin-bottom: 8px; padding: 5px 10px; border-radius: 999px; font-size: .8em; font-weight: 700; background: var(--bg-tag); color: var(--accent); }\n.spawn-status.is-spawn { background: rgba(230,126,34,.15); color: var(--warn); }\n.spawn-status.is-none { background: rgba(127,140,141,.12); color: var(--text-s); }\n.prose { font-size: .9em; line-height: 1.65; word-break: break-word; }\n.prose h3 { font-size: 1em; color: var(--accent); margin: 10px 0 6px; font-weight: 800; }\n.prose h3:first-child { margin-top: 0; }\n.prose .block-title { margin: 12px 0 6px; padding: 5px 9px; border-radius: var(--r3); background: var(--bg-tag); color: var(--accent); font-weight: 800; font-size: .88em; display: inline-block; }\n.prose .block-title:first-child { margin-top: 0; }\n.prose ul { margin: 4px 0 8px 1.15em; }\n.prose li { margin: 3px 0; }\n.prose blockquote { margin: 8px 0; padding: 8px 10px; border-left: 3px solid var(--accent); background: var(--bg-panel); border-radius: 0 var(--r3) var(--r3) 0; }\n.prose strong { font-weight: 800; }\n.prose hr { border: none; border-top: 1px dashed var(--border); margin: 10px 0; }\n.prose .prose-p { margin: 0 0 8px; white-space: pre-wrap; }\n.char-card { margin-top: 8px; padding: 10px 12px; border-radius: var(--r2); background: var(--bg-panel); border: 1px solid var(--border); }\n.char-card:first-child { margin-top: 0; }\n.char-name { font-weight: 800; color: var(--accent); font-size: .9em; margin-bottom: 6px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }\n.char-name .heart { color: var(--accent-2); }\n.char-name .role { font-weight: 600; color: var(--text-s); font-size: .85em; }\n.char-plan { font-size: .88em; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }\n.relation-line { margin-top: 8px; padding: 7px 9px; border-radius: var(--r3); background: rgba(255,107,157,.08); border: 1px dashed rgba(255,107,157,.35); font-size: .8em; line-height: 1.5; }\n.check-line { margin-top: 10px; font-size: .8em; color: var(--ok); font-weight: 700; }\n/* 进度条 ntrsProgress：默认轻高斯模糊（勉强可见），点击后清晰；无提示文案 */\n.ntr-progress-wrap {\n  position: relative;\n  border-radius: 10px;\n  min-height: 48px;\n}\n.ntr-progress-wrap.is-blurred {\n  cursor: pointer;\n  -webkit-tap-highlight-color: transparent;\n}\n.ntr-progress-wrap.is-blurred .ntr-progress-list {\n  filter: blur(3.5px);\n  -webkit-filter: blur(3.5px);\n  pointer-events: none;\n  user-select: none;\n  opacity: .88;\n}\n.ntr-progress-list { display: flex; flex-direction: column; gap: 10px; }\n.ntr-progress-row {\n  display: grid;\n  grid-template-columns: minmax(64px, 1fr) minmax(90px, 2.2fr) minmax(64px, 1fr);\n  align-items: center;\n  gap: 8px;\n  padding: 8px 10px;\n  border-radius: 10px;\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n}\n.ntr-progress-name {\n  font-weight: 700;\n  font-size: .88em;\n  color: var(--text-m);\n  word-break: break-word;\n  line-height: 1.3;\n}\n.ntr-progress-name.left { text-align: left; color: var(--accent); }\n.ntr-progress-name.right { text-align: right; color: var(--accent-2); }\n.ntr-progress-mid {\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 4px;\n  min-width: 0;\n}\n.ntr-progress-bar {\n  position: relative;\n  height: 10px;\n  border-radius: 999px;\n  background: rgba(124,92,255,.12);\n  overflow: hidden;\n  border: 1px solid rgba(124,92,255,.18);\n}\n.ntr-progress-fill {\n  height: 100%;\n  border-radius: 999px;\n  background: linear-gradient(90deg, var(--accent), var(--accent-2));\n  min-width: 2px;\n  transition: width .35s ease;\n}\n.ntr-progress-pct {\n  font-size: .72em;\n  font-weight: 700;\n  color: var(--text-s);\n  text-align: center;\n  letter-spacing: .02em;\n}\n</style>\n</head>\n<body>\n<textarea id=\"time-capsule\">$1</textarea>\n<div id=\"main-app\">\n  <div id=\"user-input-display\"></div>\n  <div class=\"inner-card\">\n    <details class=\"main-fold\">\n      <summary class=\"main-head\">\n        <div class=\"header-left\">\n          <div class=\"header-title\"><span>✦</span><span>花火的台本分发</span></div>\n          <div class=\"header-sub\" id=\"header-sub\">记忆召回 · 黄毛判定 · 导演台本</div>\n          <div class=\"header-badges\" id=\"header-badges\"></div>\n        </div>\n        <div class=\"controls-wrapper\" id=\"controlsWrapper\" onclick=\"event.preventDefault();event.stopPropagation();\">\n          <div class=\"menu-items\">\n            <button type=\"button\" class=\"theme-btn\" onclick=\"event.preventDefault();event.stopPropagation();adjustContentHeight()\" title=\"高度\"><div class=\"theme-btn-inner\">H</div></button>\n            <button type=\"button\" class=\"theme-btn\" onclick=\"event.preventDefault();event.stopPropagation();changeFontSize()\" title=\"字号\"><div class=\"theme-btn-inner\" id=\"fontIcon\">3</div></button>\n            <button type=\"button\" class=\"theme-btn\" onclick=\"event.preventDefault();event.stopPropagation();changeGlobalTheme()\" title=\"主题\"><div class=\"theme-btn-inner\">◐</div></button>\n          </div>\n          <button type=\"button\" class=\"theme-btn\" onclick=\"event.preventDefault();event.stopPropagation();toggleMenu()\" title=\"菜单\"><div class=\"theme-btn-inner\">✦</div></button>\n        </div>\n        <span class=\"main-chev\">▶</span>\n      </summary>\n      <div class=\"main-body\">\n        <div id=\"render-target\"></div>\n      </div>\n    </details>\n  </div>\n  <style id=\"custom-theme-style\"></style>\n</div>\n<script>\n/**\n * Cirno 花火台本美化 — TH iframe safe\n * - Match ty1: id + getElementById, IIFE, window.* for chrome\n * - Folds: native <details>/<summary> (no JS click)\n * - Read raw from #time-capsule (capture)\n */\n(function () {\n  function $(id) { return document.getElementById(id); }\n\n  var themes = ['white', 'retro', 'glass', 'dark-glass', 'dark', 'spark'];\n  var fontSizes = [11, 12, 13, 14.5, 16, 18];\n  var THEME_DEFS = {\n    white: { p: '#ffffff', card: '#f6f5fb', a: '#7c5cff', m: '#2c3e50', s: '#7f8c8d', tag: 'rgba(124,92,255,0.12)', b: '#e6e2f0', blur: false },\n    retro: { p: '#f2e8d5', card: 'rgba(220,205,180,0.35)', a: '#4e342e', m: '#4e342e', s: '#8d6e63', tag: 'rgba(78,52,46,0.1)', b: '#d3c2a3', blur: false },\n    glass: { p: 'rgba(255,255,255,0.45)', card: 'rgba(255,255,255,0.28)', a: '#5b4b8a', m: '#444444', s: '#666666', tag: 'rgba(91,75,138,0.1)', b: 'rgba(0,0,0,0.12)', blur: true },\n    'dark-glass': { p: 'rgba(45,40,60,0.82)', card: 'rgba(255,255,255,0.1)', a: '#d2c4ff', m: '#ffffff', s: 'rgba(255,255,255,0.62)', tag: 'rgba(210,196,255,0.16)', b: 'rgba(255,255,255,0.18)', blur: true },\n    dark: { p: '#14121a', card: '#221f2b', a: '#b39cff', m: '#e8e4f0', s: '#8a8499', tag: 'rgba(179,156,255,0.16)', b: '#322e3d', blur: false },\n    spark: { p: '#1a1024', card: '#271536', a: '#ff7eb6', m: '#ffe8f4', s: '#c49bb3', tag: 'rgba(255,126,182,0.16)', b: '#4a2a45', blur: false }\n  };\n  var themeKey = 'st_cirno_script_theme_v4';\n  var fontKey = 'st_cirno_script_font_level_v4';\n  var heightKey = 'st_cirno_script_content_height_v4';\n\n  var app = $('main-app');\n  var capsule = $('time-capsule');\n  var themeStyleTag = $('custom-theme-style');\n  var target = $('render-target');\n  var inputEl = $('user-input-display');\n  var badgeEl = $('header-badges');\n  var subEl = $('header-sub');\n  var fontIcon = $('fontIcon');\n  var controls = $('controlsWrapper');\n\n  function esc(s) {\n    return String(s == null ? '' : s)\n      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\n      .replace(/\"/g, '&quot;');\n  }\n\n  function getTag(text, tag) {\n    if (!text) return null;\n    var re = new RegExp('<' + tag + '[^>]*>([\\\\s\\\\S]*?)<\\\\/' + tag + '>', 'i');\n    var m = text.match(re);\n    return m ? m[1].replace(/^\\s+|\\s+$/g, '') : null;\n  }\n\n  function getTagAny(text, tags) {\n    for (var i = 0; i < tags.length; i++) {\n      var v = getTag(text, tags[i]);\n      if (v != null && v !== '') return v;\n    }\n    return null;\n  }\n\n  function inlineFmt(s) {\n    return esc(s).replace(/\\*\\*([^*]+)\\*\\*/g, function (_m, x) { return '<strong>' + x + '</strong>'; });\n  }\n\n  function formatProse(raw) {\n    if (!raw || !String(raw).replace(/^\\s+|\\s+$/g, '')) return '<div class=\"empty-hint\">暂无内容</div>';\n    var lines = String(raw).replace(/\\r\\n/g, '\\n').split('\\n');\n    var html = '', inUl = false, para = [];\n    function flush() {\n      if (!para.length) return;\n      var j = para.join('\\n').replace(/^\\s+|\\s+$/g, '');\n      para = [];\n      if (j) html += '<div class=\"prose-p\">' + inlineFmt(j) + '</div>';\n    }\n    function closeUl() { if (inUl) { html += '</ul>'; inUl = false; } }\n    for (var i = 0; i < lines.length; i++) {\n      var t = lines[i].replace(/\\s+$/, '');\n      var trim = t.replace(/^\\s+/, '');\n      if (!trim) { flush(); closeUl(); continue; }\n      var hm = trim.match(/^#{1,3}\\s+(.+)$/);\n      if (hm) { flush(); closeUl(); html += '<h3>' + inlineFmt(hm[1]) + '</h3>'; continue; }\n      if (/^【[^】]+】/.test(trim) || /^\\*\\*【[^】]+】/.test(trim)) {\n        flush(); closeUl();\n        html += '<div class=\"block-title\">' + inlineFmt(trim.replace(/^\\*\\*/, '').replace(/\\*\\*$/, '')) + '</div>';\n        continue;\n      }\n      if (trim === '---' || trim === '***' || trim === '___') { flush(); closeUl(); html += '<hr>'; continue; }\n      if (trim.charAt(0) === '>') {\n        flush(); closeUl();\n        html += '<blockquote>' + inlineFmt(trim.replace(/^>\\s?/, '')) + '</blockquote>';\n        continue;\n      }\n      if (/^[-*]\\s+/.test(trim)) {\n        flush();\n        if (!inUl) { html += '<ul>'; inUl = true; }\n        html += '<li>' + inlineFmt(trim.replace(/^[-*]\\s+/, '')) + '</li>';\n        continue;\n      }\n      if (/^✅/.test(trim)) { flush(); closeUl(); html += '<div class=\"check-line\">' + inlineFmt(trim) + '</div>'; continue; }\n      closeUl();\n      para.push(t);\n    }\n    flush(); closeUl();\n    return '<div class=\"prose\">' + html + '</div>';\n  }\n\n  \n  // Build AM -> 概览 map from 数据库 纪要索引 / 世界书条目\n  function parseOverviewFromText(text, map) {\n    if (!text) return;\n    var t = String(text);\n\n    // Markdown table: | 概览 | 编码索引 | or | 编码索引 | 概览 |\n    var lines = t.split(/\\r?\\n/);\n    var headerIdx = -1, codeCol = -1, sumCol = -1;\n    for (var i = 0; i < lines.length; i++) {\n      var line = lines[i].replace(/^\\s+|\\s+$/g, '');\n      if (!line || line.indexOf('|') < 0) continue;\n      if (/^\\|?\\s*:?-{3,}/.test(line)) continue;\n      var cells = line.replace(/^\\|/, '').replace(/\\|$/, '').split('|').map(function (c) {\n        return c.replace(/^\\s+|\\s+$/g, '');\n      });\n      if (headerIdx < 0) {\n        for (var c = 0; c < cells.length; c++) {\n          if (/编码索引|code[_ ]?index/i.test(cells[c])) codeCol = c;\n          if (/^概览$|summary/i.test(cells[c])) sumCol = c;\n        }\n        if (codeCol >= 0 && sumCol >= 0) { headerIdx = i; continue; }\n        // reset if not a header\n        codeCol = -1; sumCol = -1;\n      } else {\n        if (codeCol >= 0 && sumCol >= 0 && cells[codeCol] && cells[sumCol]) {\n          var code = String(cells[codeCol]).toUpperCase().match(/AM\\d+/);\n          if (code) map[code[0]] = String(cells[sumCol]).replace(/^\\s+|\\s+$/g, '');\n        }\n      }\n    }\n\n    // \"编码索引: AM0001, 概览: xxx\" / \"AM0001: xxx\"\n    var re1 = /(?:编码索引|code[_ ]?index)\\s*[:：]?\\s*(AM\\d+)[^\\n]{0,40}?(?:概览|summary)\\s*[:：]\\s*([^\\n|]+)/gi;\n    var m;\n    while ((m = re1.exec(t))) map[m[1].toUpperCase()] = m[2].replace(/^\\s+|\\s+$/g, '');\n    var re2 = /(AM\\d+)\\s*[:：|｜]\\s*([^\\n|]{2,80})/g;\n    while ((m = re2.exec(t))) {\n      var k = m[1].toUpperCase();\n      if (!map[k]) map[k] = m[2].replace(/^\\s+|\\s+$/g, '');\n    }\n  }\n\n  async function collectWorldBooks() {\n    var worldBooks = [];\n    function addBook(book) {\n      if (book && worldBooks.indexOf(book) < 0) worldBooks.push(book);\n    }\n    try {\n      if (typeof getChatLorebook === 'function') try { addBook(await getChatLorebook()); } catch (e) {}\n      if (typeof getVariables === 'function') try {\n        var v = await getVariables({ type: 'chat' });\n        if (v && v.selectedWorldBook) addBook(v.selectedWorldBook);\n      } catch (e) {}\n      if (typeof getCharLorebooks === 'function') {\n        try {\n          var b = getCharLorebooks({ type: 'all' });\n          addBook(b.primary);\n          if (b.additional) b.additional.forEach(addBook);\n        } catch (e) {}\n      } else if (typeof getCurrentCharPrimaryLorebook === 'function') {\n        try { addBook(await getCurrentCharPrimaryLorebook()); } catch (e) {}\n      }\n      if (typeof getLorebookSettings === 'function') try {\n        var s = getLorebookSettings();\n        if (s && s.selected_global_lorebooks) s.selected_global_lorebooks.forEach(addBook);\n      } catch (e) {}\n    } catch (e) {}\n    return worldBooks;\n  }\n\n  async function loadOverviewMap() {\n    var map = {};\n    try {\n      // 1) Worldbook / 纪要索引 entries\n      if (typeof getLorebookEntries === 'function') {\n        var books = await collectWorldBooks();\n        for (var bi = 0; bi < books.length; bi++) {\n          try {\n            var entries = await getLorebookEntries(books[bi]);\n            if (!entries) continue;\n            for (var ei = 0; ei < entries.length; ei++) {\n              var entry = entries[ei];\n              var content = entry && (entry.content || entry.comment || '');\n              var keys = (entry && (entry.key || entry.keys)) || [];\n              var keyStr = Array.isArray(keys) ? keys.join(' ') : String(keys || '');\n              var comment = String((entry && entry.comment) || '');\n              var blob = content + '\\n' + comment + '\\n' + keyStr;\n              if (/已发生的事件概览|纪要索引|纪要表|编码索引|AM\\d+/i.test(blob)) {\n                parseOverviewFromText(blob, map);\n              }\n              // per-AM entry: key is AM0001\n              if (Array.isArray(keys)) {\n                for (var ki = 0; ki < keys.length; ki++) {\n                  var am = String(keys[ki] || '').toUpperCase().match(/AM\\d+/);\n                  if (am && content) {\n                    // try extract 概览 from entry body\n                    var sm = String(content).match(/(?:概览|summary)\\s*[:：]\\s*([^\\n]+)/i);\n                    if (sm) map[am[0]] = sm[1].replace(/^\\s+|\\s+$/g, '');\n                    else if (!map[am[0]] && String(content).length <= 40) map[am[0]] = String(content).replace(/^\\s+|\\s+$/g, '');\n                  }\n                }\n              }\n            }\n          } catch (e) {}\n        }\n      }\n\n      // 2) Parent chat metadata sheets (if database exposes them)\n      try {\n        var meta = null;\n        if (window.parent && window.parent.SillyTavern && window.parent.SillyTavern.getContext) {\n          var ctx = window.parent.SillyTavern.getContext();\n          meta = ctx && (ctx.chat_metadata || ctx.chatMetadata);\n        } else if (typeof SillyTavern !== 'undefined' && SillyTavern.getContext) {\n          var ctx2 = SillyTavern.getContext();\n          meta = ctx2 && (ctx2.chat_metadata || ctx2.chatMetadata);\n        }\n        if (meta) {\n          // walk objects looking for sheet_summary / 纪要表 content rows\n          var stack = [meta];\n          var seen = 0;\n          while (stack.length && seen < 50) {\n            var cur = stack.pop(); seen++;\n            if (!cur || typeof cur !== 'object') continue;\n            if (cur.name === '纪要表' || cur.uid === 'sheet_summary' || (cur.sourceData && /chronicle/i.test(String(cur.sourceData.ddl || '')))) {\n              var contentArr = cur.content;\n              if (Array.isArray(contentArr) && contentArr.length > 1) {\n                var headers = contentArr[0].map(function (h) { return String(h || ''); });\n                var codeI = -1, sumI = -1;\n                for (var hi = 0; hi < headers.length; hi++) {\n                  if (/编码索引|code/i.test(headers[hi])) codeI = hi;\n                  if (/概览|summary/i.test(headers[hi])) sumI = hi;\n                }\n                for (var ri = 1; ri < contentArr.length; ri++) {\n                  var row = contentArr[ri];\n                  if (!Array.isArray(row)) continue;\n                  var codeCell = codeI >= 0 ? row[codeI] : null;\n                  var sumCell = sumI >= 0 ? row[sumI] : null;\n                  var am2 = String(codeCell || '').toUpperCase().match(/AM\\d+/);\n                  if (am2 && sumCell) map[am2[0]] = String(sumCell).replace(/^\\s+|\\s+$/g, '');\n                }\n              }\n            }\n            if (Array.isArray(cur)) {\n              for (var ai = 0; ai < Math.min(cur.length, 30); ai++) stack.push(cur[ai]);\n            } else {\n              var keys2 = Object.keys(cur);\n              for (var oi = 0; oi < Math.min(keys2.length, 40); oi++) {\n                if (keys2[oi] && (keys2[oi].indexOf('sheet') >= 0 || keys2[oi].indexOf('Sheet') >= 0 || keys2[oi].indexOf('table') >= 0 || keys2[oi].indexOf('ACU') >= 0 || keys2[oi].indexOf('metadata') >= 0)) {\n                  stack.push(cur[keys2[oi]]);\n                }\n              }\n            }\n          }\n        }\n      } catch (e) {}\n    } catch (e) {\n      console.error('[Cirno] loadOverviewMap', e);\n    }\n    return map;\n  }\n\n  function isUnclearTime(t) {\n    var s = String(t == null ? '' : t).replace(/^\\s+|\\s+$/g, '');\n    if (!s) return false;\n    // 记不清了 / 记不清 / 记不清时间 / 时间记不清 等\n    if (/记不清/.test(s)) return true;\n    if (/记不得|想不起|时间不明|时距不明|unknown\\s*time/i.test(s)) return true;\n    return false;\n  }\n\n  function parseRecall(raw) {\n    if (!raw || !String(raw).replace(/^\\s+|\\s+$/g, '')) return { now: '', rows: [], unclearCount: 0 };\n    var lines = String(raw).split(/\\r?\\n/);\n    var now = '', rows = [];\n    for (var i = 0; i < lines.length; i++) {\n      var line = lines[i].replace(/^\\s+|\\s+$/g, '');\n      if (!line) continue;\n      if (/^now\\s*=/i.test(line)) { now = line.replace(/^now\\s*=\\s*/i, ''); continue; }\n      var m = line.match(/^(AM\\d+)\\s*[|｜]\\s*(.+)$/i);\n      if (m) {\n        var rest = m[2].split(/[|｜]/);\n        var time0 = rest[0].replace(/^\\s+|\\s+$/g, '');\n        rows.push({\n          code: m[1].toUpperCase(),\n          time: time0,\n          note: rest.slice(1).join(' | ').replace(/^\\s+|\\s+$/g, ''),\n          unclear: isUnclearTime(time0)\n        });\n        continue;\n      }\n      m = line.match(/^(AM\\d+)\\s+(.+)$/i);\n      if (m) {\n        var t1 = m[2].replace(/^\\s+|\\s+$/g, '');\n        rows.push({ code: m[1].toUpperCase(), time: t1, note: '', unclear: isUnclearTime(t1) });\n        continue;\n      }\n      m = line.match(/^(AM\\d+)$/i);\n      if (m) rows.push({ code: m[1].toUpperCase(), time: '', note: '', unclear: false });\n    }\n    var unclearCount = 0;\n    for (var u = 0; u < rows.length; u++) if (rows[u].unclear) unclearCount++;\n    return { now: now, rows: rows, unclearCount: unclearCount };\n  }\n\n  function parseThugSpawn(raw) {\n    if (!raw || !String(raw).replace(/^\\s+|\\s+$/g, '')) return null;\n    var lines = String(raw).split(/\\r?\\n/);\n    var globalStatus = '';\n    var people = [];\n    var cur = null;\n    var loose = [];\n\n    function isNameKey(k) {\n      return /^(称呼|名字|姓名|名称)$/.test(String(k || '').replace(/^\\s+|\\s+$/g, ''));\n    }\n    function shortName(v) {\n      return String(v || '').split(/[（(]/)[0].replace(/^\\s+|\\s+$/g, '') || String(v || '').replace(/^\\s+|\\s+$/g, '');\n    }\n    function startPerson(nameVal, firstField) {\n      cur = { name: shortName(nameVal) || '未命名黄毛', status: '', fields: [] };\n      if (firstField) cur.fields.push(firstField);\n      people.push(cur);\n    }\n\n    for (var i = 0; i < lines.length; i++) {\n      var t = lines[i].replace(/^\\s+|\\s+$/g, '');\n      if (!t) continue;\n\n      // separator between people\n      if (/^[-—=]{3,}$/.test(t) || /^#{1,3}\\s+/.test(t) || /^(?:黄毛|威胁者)\\s*\\d+/.test(t)) {\n        cur = null;\n        continue;\n      }\n\n      var m = t.match(/^刷新状态\\s*[:：]\\s*(.+)$/);\n      if (m) {\n        if (cur) cur.status = m[1];\n        else globalStatus = m[1];\n        continue;\n      }\n\n      m = t.match(/^[-•]\\s*([^:：]+?)\\s*[:：]\\s*(.*)$/);\n      if (!m) m = t.match(/^([^:：]{1,24})\\s*[:：]\\s*(.+)$/);\n      if (m && !/^https?$/i.test(m[1])) {\n        var k = m[1].replace(/^\\s+|\\s+$/g, '');\n        var v = m[2].replace(/^\\s+|\\s+$/g, '');\n        if (isNameKey(k)) {\n          startPerson(v, { k: k, v: v });\n          continue;\n        }\n        if (!cur) {\n          // fields before any 称呼 — keep as global/loose until a name appears\n          loose.push({ k: k, v: v });\n          continue;\n        }\n        cur.fields.push({ k: k, v: v });\n        continue;\n      }\n\n      // free line\n      if (cur && cur.fields.length) cur.fields[cur.fields.length - 1].v += '\\n' + t;\n      else if (loose.length) loose[loose.length - 1].v += '\\n' + t;\n      else loose.push({ k: '备注', v: t });\n    }\n\n    // no_spawn: never invent person cards (status-only / loose text still no people)\n    function isNoSpawnStatus(s) {\n      var raw = String(s || '').replace(/^\\s+|\\s+$/g, '');\n      if (!raw) return false;\n      var compact = raw.toLowerCase().replace(/[-_\\s]/g, '');\n      if (compact === 'nospawn' || compact === 'none' || compact === 'nosawn') return true;\n      if (/^no\\s*spawn$/i.test(raw)) return true;\n      if (/不刷新|未刷新|无刷新|本轮不刷/.test(raw)) return true;\n      return false;\n    }\n\n    if (isNoSpawnStatus(globalStatus)) {\n      return { globalStatus: globalStatus || 'no_spawn', people: [], noSpawn: true };\n    }\n\n    // ALLin 复用格式提取：从 fields 里找「沿用：已有黄毛 X，锁定目标 A,B,C」\n    function extractReuseInfo(fields) {\n      var rName = '', rTargets = [];\n      for (var ri = 0; ri < fields.length; ri++) {\n        if (fields[ri].k === '沿用' || fields[ri].k === '复用') {\n          var rv = fields[ri].v;\n          var mN = rv.match(/已有黄毛\\s*(.+?)(?:[，,]\\s*锁定目标|$)/);\n          if (mN) rName = mN[1].replace(/^\\s+|\\s+$/g, '');\n          var mT = rv.match(/锁定目标\\s*(.+)/);\n          if (mT) {\n            rTargets = mT[1].split(/[,，、]/).map(function(t) { return t.replace(/^\\s+|\\s+$/g, ''); }).filter(function(t) { return t; });\n          }\n        }\n      }\n      return { name: rName, targets: rTargets };\n    }\n\n    // BATTLE 追踪块：【黄毛动向追踪】 + bullet 行\n    function extractTrackingBlock(allLines) {\n      var idx = -1;\n      for (var i = 0; i < allLines.length; i++) {\n        if (/【黄毛动向追踪】|黄毛动向追踪/.test(allLines[i])) { idx = i; break; }\n      }\n      if (idx < 0) return null;\n      var trackPeople = [];\n      // bullet 行：- [黄毛名]（锁定目标 [对象名]）：动向=...；线状态=...；五型=...；型体概要=...\n      var bulletRe = /^[-•*]\\s*\\[?([^\\[（(]+?)\\]?\\s*[（(]\\s*锁定目标\\s*[:：]?\\s*([^)）]+?)[)）]\\s*[:：]\\s*(.+)$/;\n      for (var j = idx + 1; j < allLines.length; j++) {\n        var t = allLines[j].replace(/^\\s+|\\s+$/g, '');\n        if (!t) continue;\n        // 结束标记：下一个 section 或 </thugSpawn>\n        if (/^刷新状态/.test(t) || /^称呼/.test(t) || /^<\\//.test(t)) break;\n        var bm = t.match(bulletRe);\n        if (bm) {\n          var name = bm[1].replace(/^\\s+|\\s+$/g, '');\n          var target = bm[2].replace(/^\\s+|\\s+$/g, '');\n          var rest = bm[3];\n          // 拆分 rest 里的字段（动向=...；线状态=...；五型=...；型体概要=...）\n          var parts = rest.split(/[；;]/);\n          var fields = [{ k: '锁定目标', v: target }];\n          var longBuf = [];\n          for (var p = 0; p < parts.length; p++) {\n            var pm = parts[p].match(/^\\s*([^=]+?)\\s*=\\s*(.+)$/);\n            if (!pm) { if (parts[p].replace(/^\\s+|\\s+$/g, '')) longBuf.push(parts[p]); continue; }\n            var pk = pm[1].replace(/^\\s+|\\s+$/g, '');\n            var pv = pm[2].replace(/^\\s+|\\s+$/g, '');\n            if (/^(动向|型体概要|型体)$/.test(pk)) {\n              fields.push({ k: pk, v: pv, isLong: true });\n            } else {\n              fields.push({ k: pk, v: pv });\n            }\n          }\n          if (longBuf.length) fields.push({ k: '备注', v: longBuf.join('；'), isLong: true });\n          trackPeople.push({ name: name, status: '', fields: fields, targetName: target });\n        } else if (trackPeople.length) {\n          // 续行：并入上一个人的最后一个 long 字段（如跨行型体概要）\n          var lastP = trackPeople[trackPeople.length - 1];\n          var lastField = lastP.fields[lastP.fields.length - 1];\n          if (lastField && lastField.isLong) lastField.v += '\\n' + t;\n          else lastP.fields.push({ k: '备注', v: t, isLong: true });\n        }\n      }\n      return trackPeople.length ? trackPeople : null;\n    }\n\n    // BATTLE 追踪块：若检测到【黄毛动向追踪】bullet 块，优先拆成多人\n    if (!people.length) {\n      var tracked = extractTrackingBlock(lines);\n      if (tracked && tracked.length) {\n        for (var tri = 0; tri < tracked.length; tri++) {\n          if (!tracked[tri].status && globalStatus) tracked[tri].status = globalStatus;\n        }\n        return { globalStatus: globalStatus, people: tracked, noSpawn: false, isTrackingBlock: true };\n      }\n    }\n\n    // no explicit 称呼: treat whole as one person (only when not no_spawn)\n    if (!people.length) {\n      if (!loose.length && !globalStatus) return null;\n      // bare \"spawn\" status without fields → no fake person\n      if (!loose.length && /^(spawn|刷新)$/i.test(String(globalStatus).replace(/^\\s+|\\s+$/g, ''))) {\n        return { globalStatus: globalStatus, people: [], noSpawn: false };\n      }\n      var reuse = extractReuseInfo(loose);\n      var fallbackName = reuse.name || '黄毛';\n      for (var li = 0; li < loose.length; li++) {\n        if (isNameKey(loose[li].k)) { fallbackName = shortName(loose[li].v) || fallbackName; break; }\n      }\n      people.push({ name: fallbackName, status: globalStatus, fields: loose.slice() });\n      return { globalStatus: globalStatus, people: people, noSpawn: false, reusedName: reuse.name, lockedTargets: reuse.targets };\n    }\n\n    // attach pre-name loose fields to first person (except pure status)\n    if (loose.length && people[0]) {\n      people[0].fields = loose.concat(people[0].fields);\n    }\n    // inherit global status if person has none\n    for (var pi = 0; pi < people.length; pi++) {\n      if (!people[pi].status && globalStatus) people[pi].status = globalStatus;\n    }\n    // if every person's status is no_spawn (AI put status on cards), drop people\n    var allNo = people.length > 0;\n    for (var qi = 0; qi < people.length; qi++) {\n      if (!isNoSpawnStatus(people[qi].status)) { allNo = false; break; }\n    }\n    if (allNo) {\n      return {\n        globalStatus: globalStatus || people[0].status || 'no_spawn',\n        people: [],\n        noSpawn: true\n      };\n    }\n    // ALLin: 也从 people[0].fields 提取复用信息\n    var reuse2 = extractReuseInfo(people[0] ? people[0].fields : []);\n    return { globalStatus: globalStatus, people: people, noSpawn: false, reusedName: reuse2.name, lockedTargets: reuse2.targets };\n  }\n\n  function extractNtrProgressBlock(text) {\n    if (!text) return { progressRaw: '', clean: text || '' };\n    var src = String(text);\n    var re = /<\\s*ntrs?Progress\\b[^>]*>([\\s\\S]*?)<\\/\\s*ntrs?Progress\\s*>/i;\n    var m = src.match(re);\n    if (!m) {\n      re = /<\\s*ntrProgress\\b[^>]*>([\\s\\S]*?)<\\/\\s*ntrProgress\\s*>/i;\n      m = src.match(re);\n    }\n    if (!m) return { progressRaw: '', clean: src };\n    var progressRaw = m[1];\n    var clean = src.split(m[0]).join('').replace(/\\n{3,}/g, '\\n\\n').replace(/^\\s+|\\s+$/g, '');\n    return { progressRaw: progressRaw, clean: clean };\n  }\n\n  function parseNtrProgress(raw) {\n    var rows = [];\n    if (!raw || !String(raw).replace(/^\\s+|\\s+$/g, '')) return rows;\n    var lines = String(raw).replace(/\\r\\n/g, '\\n').split('\\n');\n    for (var i = 0; i < lines.length; i++) {\n      var t = lines[i].replace(/^\\s+|\\s+$/g, '');\n      if (!t) continue;\n      if (/^\\[/.test(t) && /\\]$/.test(t)) continue;\n      if (/仅黄毛|每行一对|无已锁定|敏感对象名|结算一致|不输出该标签|心理转变进度/.test(t)) continue;\n      if (/^\\(?每行|^（每行/.test(t)) continue;\n\n      var target = '', thug = '', pct = null;\n      var m = t.match(/^(.+?)\\s*(?:↔|<->|→|->|—|–|－)\\s*(.+?)\\s*[\\[【(（]?\\s*(\\d{1,3})\\s*%?\\s*[\\]】)）]?\\s*$/);\n      if (m) {\n        target = m[1].replace(/^\\s+|\\s+$/g, '');\n        thug = m[2].replace(/^\\s+|\\s+$/g, '');\n        pct = parseInt(m[3], 10);\n      } else {\n        m = t.match(/^(.+?)\\s+(\\d{1,3})\\s*%\\s*$/);\n        if (m) {\n          target = m[1].replace(/^\\s+|\\s+$/g, '');\n          thug = '—';\n          pct = parseInt(m[2], 10);\n        }\n      }\n      if (pct == null || isNaN(pct)) continue;\n      if (pct < 0) pct = 0;\n      if (pct > 100) pct = 100;\n      // strip trailing % leftover on names\n      target = target.replace(/\\s*\\d{1,3}\\s*%\\s*$/, '').replace(/^\\s+|\\s+$/g, '');\n      thug = thug.replace(/\\s*\\d{1,3}\\s*%\\s*$/, '').replace(/^\\s+|\\s+$/g, '');\n      if (!target) continue;\n      rows.push({ target: target, thug: thug || '—', pct: pct });\n    }\n    return rows;\n  }\n\n  function renderNtrProgress(rows) {\n    if (!rows || !rows.length) {\n      return '<div class=\"empty-hint\">本轮无进度条数据</div>';\n    }\n    var h = '';\n    h += '<div class=\"ntr-progress-wrap is-blurred\" onclick=\"window.cirnoRevealNtrProgress && window.cirnoRevealNtrProgress(this)\">';\n    h += '<div class=\"ntr-progress-list\">';\n    for (var i = 0; i < rows.length; i++) {\n      var r = rows[i];\n      var w = Math.max(0, Math.min(100, r.pct));\n      h += '<div class=\"ntr-progress-row\">';\n      h += '<div class=\"ntr-progress-name left\">' + esc(r.target) + '</div>';\n      h += '<div class=\"ntr-progress-mid\">';\n      h += '<div class=\"ntr-progress-bar\"><div class=\"ntr-progress-fill\" style=\"width:' + w + '%\"></div></div>';\n      h += '<div class=\"ntr-progress-pct\">' + w + '%</div>';\n      h += '</div>';\n      h += '<div class=\"ntr-progress-name right\">' + esc(r.thug) + '</div>';\n      h += '</div>';\n    }\n    h += '</div></div>';\n    return h;\n  }\n\n  window.cirnoRevealNtrProgress = function (el) {\n    try {\n      if (!el) return;\n      el.classList.remove('is-blurred');\n    } catch (e) {}\n  };\n\n  function parsePlot(raw) {\n    if (!raw || !String(raw).replace(/^\\s+|\\s+$/g, '')) return { introHtml: '', chars: [], check: '', ntrProgress: [] };\n    var extracted = extractNtrProgressBlock(raw);\n    var text = String(extracted.clean || '').replace(/\\r\\n/g, '\\n');\n    var nestedProgress = parseNtrProgress(extracted.progressRaw || '');\n    var charRe = /(?:^|\\n)\\*\\s+\\*\\*([^*\\n]+)\\*\\*\\s*[-—–]?\\s*(?:正确的表演计划)?\\s*[:：]?\\s*\\n/g;\n    var matches = [], m;\n    while ((m = charRe.exec(text)) !== null) {\n      matches.push({ name: m[1].replace(/^\\s+|\\s+$/g, ''), index: m.index, end: m.index + m[0].length });\n    }\n    var intro = text, chars = [];\n    if (matches.length) {\n      intro = text.slice(0, matches[0].index).replace(/^\\s+|\\s+$/g, '');\n      for (var i = 0; i < matches.length; i++) {\n        var start = matches[i].end;\n        var end = i + 1 < matches.length ? matches[i + 1].index : text.length;\n        var body = text.slice(start, end).replace(/^\\s+|\\s+$/g, '');\n        var relation = '';\n        var rel = body.match(/「?\\*\\*关系暗线\\*\\*[：:]?[\\s\\S]*?」/) ||\n          body.match(/\\*\\*关系暗线\\*\\*[：:]?[^\\n]*(?:\\n(?!\\*\\s+\\*\\*)[^\\n]*)*/);\n        if (rel) {\n          relation = rel[0].replace(/^[「]|[」]$/g, '').replace(/^\\s+|\\s+$/g, '');\n          body = body.split(rel[0]).join('').replace(/^\\s+|\\s+$/g, '');\n        }\n        body = body.replace(/^「/, '').replace(/」\\s*$/, '');\n        body = body.replace(/\\n---[\\s\\S]*$/, '').replace(/\\n✅[\\s\\S]*$/, '').replace(/^\\s+|\\s+$/g, '');\n        chars.push({ name: matches[i].name, plan: body, relation: relation });\n      }\n    }\n    var check = '';\n    var ck = text.match(/✅[^\\n]+/);\n    if (ck) check = ck[0].replace(/^\\s+|\\s+$/g, '');\n    return { introHtml: formatProse(intro), chars: chars, check: check, ntrProgress: nestedProgress };\n  }\n\n  function renderRecall(data, overviewMap) {\n    overviewMap = overviewMap || {};\n    if (!data.rows.length && !data.now) return '<div class=\"empty-hint\">本轮无召回锚点</div>';\n    var h = '';\n    if (data.now) h += '<div class=\"now-line\">now = ' + esc(data.now) + '</div>';\n    if (data.unclearCount > 0) {\n      h += '<div class=\"recall-unclear-hint\">时距含「记不清了」×' + data.unclearCount + ' · 请重新 roll 召回</div>';\n    }\n    if (!data.rows.length) return h + '<div class=\"empty-hint\">AM 表为空</div>';\n    h += '<table class=\"am-table\"><thead><tr><th>编码</th><th>时距</th><th>概览</th></tr></thead><tbody>';\n    for (var i = 0; i < data.rows.length; i++) {\n      var r = data.rows[i];\n      var ov = overviewMap[r.code] || overviewMap[String(r.code).toUpperCase()] || '';\n      var timeCls = r.unclear ? 'am-time is-unclear' : 'am-time';\n      h += '<tr' + (r.unclear ? ' class=\"am-row-unclear\"' : '') + '><td><span class=\"am-code\">' + esc(r.code) + '</span></td><td class=\"' + timeCls + '\">' + esc(r.time) + '</td><td class=\"am-overview\">' + esc(ov || '—') + '</td></tr>';\n    }\n    return h + '</tbody></table>';\n  }\n\n  \n  // Multi-thug: one act/no-act token per line, order matches thug list\n  function parseThugActions(raw) {\n    if (raw == null) return [];\n    var text = String(raw).replace(/\\r\\n/g, '\\n');\n    var tokens = [];\n    // Prefer line-based: each non-empty line that is act/no-act\n    var lines = text.split('\\n');\n    var lineTokens = 0;\n    for (var i = 0; i < lines.length; i++) {\n      var t = lines[i].replace(/^\\s+|\\s+$/g, '');\n      if (!t) continue;\n      if (/^no-?act\\b/i.test(t) && !/[,，;；]/.test(t) && t.split(/\\s+/).length <= 2) {\n        tokens.push('no-act');\n        lineTokens++;\n        continue;\n      }\n      if (/^act\\b/i.test(t) && !/[,，;；]/.test(t) && !/^act\\s*\\//i.test(t) && t.split(/\\s+/).length <= 2 && !/no/i.test(t)) {\n        // pure act line (not \"act no-act\")\n        if (/^act$/i.test(t) || /^act[.。!！]?$/i.test(t)) {\n          tokens.push('act');\n          lineTokens++;\n          continue;\n        }\n      }\n      // line with multiple tokens separated by comma/space\n      if (/act/i.test(t)) {\n        var parts = t.split(/[,，;；\\/|｜]+|\\s+/);\n        var got = 0;\n        for (var j = 0; j < parts.length; j++) {\n          var p2 = parts[j].replace(/^\\s+|\\s+$/g, '');\n          if (!p2) continue;\n          if (/^no-?act$/i.test(p2)) { tokens.push('no-act'); got++; }\n          else if (/^act$/i.test(p2)) { tokens.push('act'); got++; }\n        }\n        if (got) lineTokens += got;\n      }\n    }\n    if (!tokens.length) {\n      var whole = text.replace(/^\\s+|\\s+$/g, '');\n      if (/^no-?act$/i.test(whole)) tokens.push('no-act');\n      else if (/^act$/i.test(whole)) tokens.push('act');\n    }\n    return tokens;\n  }\n\n  function actionInlineHtml(token) {\n    if (!token) return '';\n    var isNo = /^no-?act$/i.test(token);\n    var label = isNo ? 'no-act' : 'act';\n    return '<span class=\"action-inline ' + (isNo ? 'no-act' : 'act') + '\">' + esc(label) + '</span>';\n  }\n\n  function renderThug(spawn, action) {\n    if (!spawn && (action == null || String(action).replace(/^\\s+|\\s+$/g, '') === '')) {\n      return '<div class=\"empty-hint\">本轮未刷新黄毛 · 仅占位美化</div>';\n    }\n    var h = '';\n    var people = (spawn && spawn.people) ? spawn.people : [];\n    var actions = parseThugActions(action);\n    var isNoSpawn = !!(spawn && (spawn.noSpawn || (function (s) {\n      var raw = String(s || '').replace(/^\\s+|\\s+$/g, '');\n      if (!raw) return false;\n      var compact = raw.toLowerCase().replace(/[-_\\s]/g, '');\n      return compact === 'nospawn' || compact === 'none' || /^no\\s*spawn$/i.test(raw) || /不刷新|未刷新|无刷新|本轮不刷/.test(raw);\n    })(spawn.globalStatus)));\n\n    // ALLin 多目标：一黄毛 × N 目标，act/no-act 按目标行序\n    var reusedName = (spawn && spawn.reusedName) ? spawn.reusedName : '';\n    var lockedTargets = (spawn && spawn.lockedTargets) ? spawn.lockedTargets : [];\n\n    if (isNoSpawn || !people.length) {\n      if (isNoSpawn) {\n        h += '<div class=\"empty-hint\">本轮未刷新黄毛（no_spawn）</div>';\n      } else {\n        h += '<div class=\"empty-hint\">无 thugSpawn 内容</div>';\n      }\n      if (actions.length) {\n        h += '<div class=\"thug-action-fallback\">';\n        for (var ai = 0; ai < actions.length; ai++) h += actionInlineHtml(actions[ai]) + ' ';\n        h += '</div>';\n      }\n      return h;\n    }\n\n    // ALLin 多目标：1 黄毛 + N 目标行 → 目标↔act 对齐\n    if (lockedTargets.length > 1) {\n      var p0 = people[0] || { name: reusedName || '黄毛', status: '', fields: [] };\n      var cardName = reusedName || p0.name || '黄毛';\n      // 黄毛人卡（沿用格式时字段含「沿用/锁定指令」，不重复拆人设）\n      var body0 = '';\n      if (p0.fields && p0.fields.length) {\n        body0 += '<div class=\"kv-list\">';\n        for (var j0 = 0; j0 < p0.fields.length; j0++) {\n          body0 += '<div class=\"kv-row\"><div class=\"kv-k\">' + esc(p0.fields[j0].k) + '</div><div class=\"kv-v\">' + esc(p0.fields[j0].v) + '</div></div>';\n        }\n        body0 += '</div>';\n      }\n      h += '<div class=\"thug-people\">';\n      h += detailsSub('👤', esc(cardName), '', body0, false);\n      // 目标↔act 对齐列表\n      h += '<div class=\"thug-target-list\">';\n      for (var tii = 0; tii < lockedTargets.length; tii++) {\n        var ttok = '';\n        if (actions.length === 1) ttok = actions[0]; // 单值广播\n        else if (tii < actions.length) ttok = actions[tii];\n        h += '<div class=\"thug-target-row\">';\n        h += '<span class=\"thug-target-name\">' + esc(lockedTargets[tii]) + '</span>';\n        h += actionInlineHtml(ttok);\n        h += '</div>';\n      }\n      h += '</div>';\n      // 多余 action（理论上不该有）\n      if (actions.length > lockedTargets.length) {\n        for (var ek = lockedTargets.length; ek < actions.length; ek++) h += actionInlineHtml(actions[ek]) + ' ';\n      }\n      h += '</div>';\n      return h;\n    }\n\n    h += '<div class=\"thug-people\">';\n    for (var i = 0; i < people.length; i++) {\n      var p = people[i];\n      // 1:1 by order; single action applies to the only person; extras ignored\n      var token = '';\n      if (actions.length === 1 && people.length === 1) token = actions[0];\n      else if (i < actions.length) token = actions[i];\n      else if (actions.length === 1 && people.length > 1) token = ''; // multi people but single token: don't mis-assign to all\n      else token = '';\n\n      var metaParts = [];\n      if (people.length > 1) metaParts.push((i + 1) + '/' + people.length);\n      if (p.targetName) metaParts.push('<span class=\"thug-target-label\">锁定 ' + esc(p.targetName) + '</span>');\n      if (token) metaParts.push(actionInlineHtml(token));\n      var meta = metaParts.join(' ');\n      var body = '';\n      if (p.fields && p.fields.length) {\n        // 短字段直出；长字段（动向/型体概要等）收进折叠\n        var shortFields = [], longFields = [];\n        for (var j = 0; j < p.fields.length; j++) {\n          if (p.fields[j].isLong) longFields.push(p.fields[j]);\n          else shortFields.push(p.fields[j]);\n        }\n        if (shortFields.length) {\n          body += '<div class=\"kv-list\">';\n          for (var js = 0; js < shortFields.length; js++) {\n            body += '<div class=\"kv-row\"><div class=\"kv-k\">' + esc(shortFields[js].k) + '</div><div class=\"kv-v\">' + esc(shortFields[js].v) + '</div></div>';\n          }\n          body += '</div>';\n        }\n        if (longFields.length) {\n          body += '<details class=\"thug-track-detail\"><summary>详情</summary><div class=\"kv-list\">';\n          for (var jl = 0; jl < longFields.length; jl++) {\n            body += '<div class=\"kv-row\"><div class=\"kv-k\">' + esc(longFields[jl].k) + '</div><div class=\"kv-v\">' + esc(longFields[jl].v) + '</div></div>';\n          }\n          body += '</div></details>';\n        }\n      } else {\n        body += '<div class=\"empty-hint\">无人设字段</div>';\n      }\n      h += detailsSub('👤', esc(p.name), meta, body, false);\n    }\n    h += '</div>';\n\n    // if more action tokens than people, show leftovers (shouldn't happen)\n    if (actions.length > people.length) {\n      h += '<div class=\"thug-action-fallback\">';\n      for (var k = people.length; k < actions.length; k++) h += actionInlineHtml(actions[k]) + ' ';\n      h += '</div>';\n    }\n    return h;\n  }\n\n  function renderPlot(parsed) {\n    var h = '';\n    if (parsed.introHtml) h += parsed.introHtml;\n    for (var i = 0; i < parsed.chars.length; i++) {\n      var c = parsed.chars[i];\n      var heart = /💔/.test(c.name + c.plan + (c.relation || ''));\n      h += '<div class=\"char-card\"><div class=\"char-name\">' + esc(c.name) +\n        (heart ? ' <span class=\"heart\">💔</span>' : '') +\n        ' <span class=\"role\">表演计划</span></div>';\n      h += '<div class=\"char-plan\">' + inlineFmt(c.plan) + '</div>';\n      if (c.relation) h += '<div class=\"relation-line\">' + inlineFmt(c.relation) + '</div>';\n      h += '</div>';\n    }\n    if (!parsed.chars.length && !parsed.introHtml) h += '<div class=\"empty-hint\">暂无导演批评</div>';\n    if (parsed.check) h += '<div class=\"check-line\">' + esc(parsed.check) + '</div>';\n    return h;\n  }\n\n  function detailsSec(ico, title, meta, bodyHtml, open) {\n    var extraClass = (title && title.indexOf('盛大演出台本') >= 0) ? ' stage-sec' : '';\n    return '<details class=\"sec' + extraClass + '\"' + (open ? ' open' : '') + '>' +\n      '<summary class=\"sec-head\"><span class=\"sec-title\"><span class=\"ico\">' + ico +\n      '</span><span>' + title + '</span></span><span class=\"sec-meta\">' + (meta || '') +\n      '<span class=\"sec-chev\">▶</span></span></summary><div class=\"sec-body\">' + bodyHtml + '</div></details>';\n  }\n  function detailsSub(ico, title, meta, bodyHtml, open) {\n    return '<details class=\"sub-sec\"' + (open ? ' open' : '') + '>' +\n      '<summary class=\"sec-head\"><span class=\"sec-title\"><span class=\"ico\">' + ico +\n      '</span><span>' + title + '</span></span><span class=\"sec-meta\">' + (meta || '') +\n      '<span class=\"sec-chev\">▶</span></span></summary><div class=\"sec-body\">' + bodyHtml + '</div></details>';\n  }\n\n  function readRaw() {\n    if (!capsule) return '';\n    var raw = capsule.value || '';\n    if (raw && raw.replace(/^\\s+|\\s+$/g, '')) return raw;\n    return capsule.textContent || '';\n  }\n\n  function applyTheme() {\n    var name = localStorage.getItem(themeKey) || 'white';\n    var c = THEME_DEFS[name] || THEME_DEFS.white;\n    var blur = c.blur ? 'blur(12px) saturate(160%)' : 'none';\n    if (app) app.setAttribute('data-theme', name);\n    if (themeStyleTag) {\n      themeStyleTag.textContent =\n        'html body #main-app{--bg-panel:' + c.p + '!important;--bg-card:' + c.card +\n        '!important;--accent:' + c.a + '!important;--text-m:' + c.m + '!important;--text-s:' + c.s +\n        '!important;--border:' + c.b + '!important;--bg-tag:' + c.tag + '!important;--blur:' + blur +\n        '!important;backdrop-filter:var(--blur)!important;-webkit-backdrop-filter:var(--blur)!important;}';\n    }\n  }\n  function applyFont() {\n    var fLevel = parseInt(localStorage.getItem(fontKey), 10) || 3;\n    document.documentElement.style.setProperty('--base-fs', fontSizes[fLevel - 1] + 'px');\n    if (fontIcon) fontIcon.innerText = String(fLevel);\n  }\n  function applyHeight() {\n    var h = localStorage.getItem(heightKey);\n    if (h == null) h = '560';\n    document.documentElement.style.setProperty('--content-h', h === '' ? 'none' : h + 'px');\n  }\n\n  window.toggleMenu = function () {\n    if (controls) controls.classList.toggle('open');\n  };\n  window.changeGlobalTheme = function () {\n    var c = localStorage.getItem(themeKey) || 'white';\n    var idx = themes.indexOf(c);\n    localStorage.setItem(themeKey, themes[(idx < 0 ? 0 : idx + 1) % themes.length]);\n    applyTheme();\n  };\n  window.changeFontSize = function () {\n    var c = parseInt(localStorage.getItem(fontKey), 10) || 3;\n    localStorage.setItem(fontKey, String((c % 6) + 1));\n    applyFont();\n  };\n  window.adjustContentHeight = function () {\n    var saved = localStorage.getItem(heightKey);\n    if (saved == null) saved = '560';\n    var val = prompt('输入内容区最大高度，留空则不限制（例如 560）:', saved);\n    if (val !== null) {\n      localStorage.setItem(heightKey, String(val).replace(/^\\s+|\\s+$/g, ''));\n      applyHeight();\n    }\n  };\n\n  async function render() {\n    try {\n      if (!target) {\n        console.error('[Cirno] #render-target missing');\n        return;\n      }\n      var raw = readRaw();\n      if (!raw || !raw.replace(/^\\s+|\\s+$/g, '')) {\n        target.innerHTML = '<div class=\"empty-hint\">未读到台本原文（time-capsule 为空）。请确认正则捕获 已注入，且 JS-Slash-Runner 代码渲染已开启。</div>';\n        if (inputEl) { inputEl.style.display = 'none'; inputEl.textContent = ''; inputEl.classList.remove('crt-flicker', 'crt-signal'); inputEl.removeAttribute('data-calib'); inputEl.removeAttribute('title'); }\n        if (app) { app.classList.remove('has-input'); app.classList.remove('has-calib'); app.classList.remove('has-signal'); }\n        return;\n      }\n\n      // revise: {{userCalib}} is injected into <User_Input> as <userCalib>...</userCalib>\n      var calibRaw = getTagAny(raw, ['userCalib', 'usercalib', 'UserCalib']);\n      var userInput = getTagAny(raw, ['User_Input', '用户本轮输入', '本轮用户输入', '用户输入']);\n      if (!userInput) {\n        var mUser = raw.match(/<(?:User_Input|用户本轮输入|本轮用户输入)[^>]*>([\\s\\S]*?)<\\/(?:User_Input|用户本轮输入|本轮用户输入)>/i);\n        if (mUser) userInput = mUser[1].replace(/^\\s+|\\s+$/g, '');\n      }\n      var isCalib = !!(calibRaw && String(calibRaw).replace(/^\\s+|\\s+$/g, ''));\n      if (isCalib) {\n        userInput = String(calibRaw).replace(/^\\s+|\\s+$/g, '');\n      } else if (userInput) {\n        // strip nested calib tags if present but empty outer detection\n        var nested = userInput.match(/<userCalib[^>]*>([\\s\\S]*?)<\\/userCalib>/i);\n        if (nested && nested[1].replace(/^\\s+|\\s+$/g, '')) {\n          userInput = nested[1].replace(/^\\s+|\\s+$/g, '');\n          isCalib = true;\n        }\n      }\n\n      if (inputEl) {\n        inputEl.textContent = userInput || '';\n        inputEl.style.display = userInput ? 'block' : 'none';\n        // always CRT frame when there is input; calib = unstable signal, else = stable signal\n        inputEl.classList.remove('crt-flicker', 'crt-signal');\n        inputEl.removeAttribute('data-calib');\n        inputEl.removeAttribute('title');\n        if (userInput) {\n          if (isCalib) {\n            inputEl.classList.add('crt-flicker');\n            inputEl.setAttribute('data-calib', '1');\n            inputEl.setAttribute('title', '输入校准 userCalib（信号不稳）');\n          } else {\n            inputEl.classList.add('crt-signal');\n            inputEl.setAttribute('title', '本轮输入（正常信号）');\n          }\n        }\n      }\n      if (app) {\n        if (userInput) app.classList.add('has-input');\n        else app.classList.remove('has-input');\n        if (isCalib && userInput) app.classList.add('has-calib');\n        else app.classList.remove('has-calib');\n        if (userInput && !isCalib) app.classList.add('has-signal');\n        else app.classList.remove('has-signal');\n      }\n\n      var recallRaw = getTagAny(raw, ['recall']);\n      var thugSpawnRaw = getTagAny(raw, ['thugSpawn', 'thugspawn']);\n      var thugActionRaw = getTagAny(raw, ['thugAction', 'thugaction']);\n      var prologueRaw = getTagAny(raw, ['prologue']);\n      var plotRaw = getTagAny(raw, ['plot']);\n\n      // If no tags found at all but raw exists, show raw as fallback so user sees content\n      var hasAny = !!(recallRaw || thugSpawnRaw || thugActionRaw || prologueRaw || plotRaw || userInput);\n      if (!hasAny) {\n        target.innerHTML =\n          '<div class=\"empty-hint\">已读到原文但未解析到标签，以下为原文预览：</div>' +\n          '<pre style=\"white-space:pre-wrap;font-size:0.85em;padding:8px;background:var(--bg-card);border-radius:8px;max-height:400px;overflow:auto;\">' +\n          esc(raw.slice(0, 4000)) + '</pre>';\n        return;\n      }\n\n      var recall = parseRecall(recallRaw || '');\n      var overviewMap = await loadOverviewMap();\n      parseOverviewFromText(raw, overviewMap);\n      var spawn = parseThugSpawn(thugSpawnRaw || '');\n      var action = thugActionRaw;\n      var topProgressRaw = getTagAny(raw, ['ntrsProgress', 'ntrProgress', 'ntrsprogress', 'ntrprogress']);\n      var plotExtract = extractNtrProgressBlock(plotRaw || '');\n      var plotForParse = plotExtract.clean || '';\n      var plotParsed = parsePlot(plotForParse || '');\n      // merge: top-level tag > nested in plot (parsePlot also strips if still present)\n      var ntrRows = parseNtrProgress(topProgressRaw || plotExtract.progressRaw || '');\n      if (!ntrRows.length && plotParsed && plotParsed.ntrProgress && plotParsed.ntrProgress.length) {\n        ntrRows = plotParsed.ntrProgress;\n      }\n      // 导演批评不展示 ntrsProgress 原文\n      plotRaw = plotForParse;\n\n      var badges = [];\n      var people = (spawn && spawn.people) ? spawn.people : [];\n      var gStatus = spawn ? (spawn.globalStatus || (people[0] && people[0].status) || '') : '';\n      var hasSpawn = !!(spawn && (people.length || gStatus || (spawn.fields && spawn.fields.length)));\n      var hasAction = !!(thugActionRaw && String(thugActionRaw).replace(/^\\s+|\\s+$/g, ''));\n      var hasPrologue = !!(prologueRaw && String(prologueRaw).replace(/^\\s+|\\s+$/g, ''));\n      var hasPlot = !!(plotRaw && String(plotRaw).replace(/^\\s+|\\s+$/g, ''));\n      // no_act → stage3 可不产出；thugSpawn 不再作为缺失必检\n      function isAllNoAct(actionRaw) {\n        var tokens = parseThugActions(actionRaw);\n        if (!tokens.length) {\n          var t = String(actionRaw == null ? '' : actionRaw).replace(/^\\s+|\\s+$/g, '');\n          if (!t) return false;\n          if (/^no[_\\s-]?act$/i.test(t)) return true;\n          var lines = t.split(/\\r?\\n/);\n          var any = false;\n          for (var li = 0; li < lines.length; li++) {\n            var ln = lines[li].replace(/^\\s+|\\s+$/g, '');\n            if (!ln) continue;\n            any = true;\n            if (!/^no[_\\s-]?act\\b/i.test(ln)) return false;\n          }\n          return any;\n        }\n        for (var ti = 0; ti < tokens.length; ti++) {\n          if (!/^no-?act$/i.test(tokens[ti])) return false;\n        }\n        return true;\n      }\n      var actionIsNoAct = hasAction && isAllNoAct(thugActionRaw);\n      // 缺失检查：\n      // - 不要求 thugSpawn（黄毛刷新状态）\n      // - 有 thugAction 且为 no_act → 不要求 prologue/plot\n      // - 有 act 或行动标签完全缺失时：缺 action 仍警告；有 act 时仍要求 stage3\n      var missing = [];\n      if (!hasAction) missing.push('thugAction');\n      if (!actionIsNoAct) {\n        if (!hasPrologue) missing.push('prologue');\n        if (!hasPlot) missing.push('plot');\n      }\n      var unclearN = (recall && recall.unclearCount) ? recall.unclearCount : 0;\n      if (unclearN > 0) missing.push('召回时距·记不清了×' + unclearN);\n      var needRerun = missing.length > 0;\n      var needRerollRecall = unclearN > 0;\n\n      badges.push('<span class=\"badge ' + (recall.rows.length ? 'ok' : 'empty') + '\">召回 ' + recall.rows.length + '</span>');\n      if (people.length) {\n        var st0 = String(gStatus || '').toLowerCase();\n        badges.push('<span class=\"badge ' + (/spawn|刷新|登场/.test(st0) || people.length ? 'spawn' : 'empty') + '\">黄毛 ' + people.length + '人</span>');\n      } else if (gStatus) {\n        var stg = gStatus.toLowerCase();\n        badges.push('<span class=\"badge ' + (/spawn|刷新|登场/.test(stg) ? 'spawn' : 'empty') + '\">黄毛 ' + esc(gStatus) + '</span>');\n      } else badges.push('<span class=\"badge empty\">黄毛 —</span>');\n      badges.push('<span class=\"badge ' + (hasPrologue ? 'ok' : 'empty') + '\">报幕</span>');\n      badges.push('<span class=\"badge ' + (hasPlot ? 'ok' : 'empty') + '\">批评</span>');\n      if (needRerun) {\n        if (needRerollRecall && missing.length === 1) {\n          badges.unshift('<span class=\"badge warn\" title=\"时距含记不清了\">⚠ 请重新 roll</span>');\n        } else if (needRerollRecall) {\n          badges.unshift('<span class=\"badge warn\" title=\"' + esc(missing.join(', ')) + '\">⚠ 请重新 roll / 推进</span>');\n        } else {\n          badges.unshift('<span class=\"badge warn\" title=\"缺失: ' + esc(missing.join(', ')) + '\">⚠ 请重新推进</span>');\n        }\n      }\n      if (badgeEl) badgeEl.innerHTML = badges.join('');\n\n      if (subEl) {\n        if (needRerollRecall && missing.length === 1) {\n          subEl.innerHTML = '<span class=\"header-warn\">召回时距含「记不清了」×' + unclearN + ' · 请重新 roll</span>';\n        } else if (needRerun) {\n          subEl.innerHTML = '<span class=\"header-warn\">台本不完整（' + esc(missing.join(' / ')) + '）· 请重新 roll / 推进</span>';\n        } else {\n          subEl.textContent = '记忆召回 · 黄毛判定 · 导演台本';\n        }\n      }\n      if (app) {\n        if (needRerun) app.classList.add('need-rerun');\n        else app.classList.remove('need-rerun');\n      }\n\n      var htmlOut = '';\n      htmlOut += detailsSec('🌊', '时间泛起涟漪', recall.rows.length ? (recall.rows.length + ' 条 AM') : '空', renderRecall(recall, overviewMap), false);\n      var spawnNo = !!(spawn && (spawn.noSpawn || /^(no[_\\s-]?spawn|不刷新|未刷新|无刷新)$/i.test(String(gStatus || '').replace(/^\\s+|\\s+$/g, ''))));\n      var spawnLabel = spawnNo ? 'no_spawn' : (people.length ? (people.length + ' 人') : (gStatus ? esc(gStatus) : '空'));\n      htmlOut += detailsSec(\n        '👤', '黄毛刷新 · 行动',\n        spawnLabel,\n        renderThug(spawn, action), false\n      );\n      if (ntrRows.length) {\n        htmlOut += detailsSec(\n          '💗', '进度条',\n          ntrRows.length + ' 条',\n          renderNtrProgress(ntrRows), false\n        );\n      }\n      var prologueBody = prologueRaw ? formatProse(prologueRaw) : '<div class=\"empty-hint\">暂无报幕</div>';\n      var plotBody = plotRaw ? renderPlot(plotParsed) : '<div class=\"empty-hint\">暂无导演批评</div>';\n      var stageInner = '<div class=\"sub-grid\">' +\n        detailsSub('🎭', '导演介绍', prologueRaw ? 'prologue' : '空', prologueBody, true) +\n        detailsSub('🎬', '导演批评', plotRaw ? 'plot' : '空', plotBody, true) +\n        '</div>';\n      htmlOut += detailsSec('📜', '花火的盛大演出台本', '导演介绍 / 导演批评', stageInner, false);\n\n      target.innerHTML = htmlOut;\n    } catch (e) {\n      console.error('[Cirno] render error', e);\n      if (target) {\n        target.innerHTML = '<div style=\"padding:12px;color:#c0392b;\">渲染失败: ' + esc(e && e.message) + '</div>';\n      }\n    }\n  }\n\n  // Chrome handlers must exist even if DOM partial\n  try {\n    applyTheme();\n    applyFont();\n    applyHeight();\n  } catch (e) { console.error(e); }\n\n  // ty1 pattern: delayed init (TH iframe settle)\n  function boot() {\n    try { Promise.resolve(render()).catch(function(e){ console.error(e); }); } catch (e) { console.error(e); }\n  }\n  setTimeout(boot, 100);\n\n})();\n\n</script>\n</body>\n</html>\n\n```",
