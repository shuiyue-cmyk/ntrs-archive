                "trimStrings": [],
                "replaceString": "```html\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\n<script src=\"https://drive.baibai.cv/f/ZKEBuW/Music.js\"></script>\n<style>\n/* ───────── 星空主题（清晰版，无毛玻璃）──────── */\n@keyframes twinkle {\n  0%, 100% { opacity: 0.28; transform: scale(1); }\n  50%      { opacity: 1;   transform: scale(1.2); }\n}\n@keyframes twinkleSoft {\n  0%, 100% { opacity: 0.4; text-shadow: 0 0 0px currentColor; }\n  50%      { opacity: 1;   text-shadow: 0 0 2px currentColor; }\n}\n@keyframes vinylSpin {\n  from { transform: rotate(0deg); }\n  to   { transform: rotate(360deg); }\n}\n@keyframes equalizeWave {\n  0%, 100% { height: 4px; }\n  50%      { height: 12px; }\n}\n@keyframes choiceFlyIn {\n  to { opacity: 1; transform: translateY(0); }\n}\n* { box-sizing: border-box; }\nbody {\n  margin: 0;\n  padding: 8px 12px;\n  background: transparent;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Noto Sans SC\", sans-serif;\n}\n.starry-player {\n  --st-text: currentColor;\n  --t-main: var(--st-text);\n  --t-dim: color-mix(in srgb, var(--st-text) 76%, transparent);\n  --t-mute: color-mix(in srgb, var(--st-text) 48%, transparent);\n  --t-line: color-mix(in srgb, var(--st-text) 26%, transparent);\n  --tr: .4s cubic-bezier(.33, 1, .68, 1);\n  position: relative;\n  width: 100%;\n  margin: 8px 0;\n  border-top: none;\n  border-bottom: none;\n  padding: 0;\n  color: var(--t-dim);\n  background: none;\n}\n.player-head {\n  list-style: none;\n  display: grid;\n  grid-template-columns: 34px minmax(0, 1fr) 34px;\n  align-items: center;\n  min-height: 38px;\n  padding: 8px 18px;\n  cursor: pointer;\n  user-select: none;\n  color: var(--t-dim);\n  background: none;\n  transition: color var(--tr);\n}\n.player-head::-webkit-details-marker { display: none; }\n.player-balance { visibility: hidden; }\n.player-title-box {\n  grid-column: 2;\n  justify-self: center;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n}\n.player-title-box::before,\n.player-title-box::after {\n  content: \"\";\n  font-size: 13px;\n  color: var(--t-dim);\n  opacity: 0.8;\n  animation: twinkle ease-in-out infinite;\n  line-height: 1;\n  background: none;\n}\n.player-title-box::before {\n  content: \"⊹ ࣪ ˖\";\n  animation-duration: 2.4s;\n  animation-delay: 0.1s;\n  margin-right: 2px;\n}\n.player-title-box::after {\n  content: \"˖ ࣪ ⊹\";\n  animation-duration: 2.2s;\n  animation-delay: 0.7s;\n  margin-left: 2px;\n}\n.player-title {\n  display: inline-flex;\n  font-family: inherit;\n  font-size: 13px;\n  font-weight: 400;\n  letter-spacing: 0.12em;\n  line-height: 1.18;\n  white-space: nowrap;\n  color: var(--t-dim);\n}\n.player-arrow {\n  grid-column: 3;\n  justify-self: center;\n  width: 8px;\n  height: 8px;\n  border-right: 1.5px solid var(--t-mute);\n  border-bottom: 1.5px solid var(--t-mute);\n  transform: translateY(-2px) rotate(45deg);\n  opacity: 0.64;\n  transition: transform 0.22s ease, opacity 0.22s ease;\n}\n.starry-player[open] .player-arrow {\n  transform: translateY(2px) rotate(225deg);\n  opacity: 0.9;\n  border-color: var(--t-main);\n}\n.player-body {\n  position: relative;\n  z-index: 1;\n  padding: 0 13px 14px 13px;\n  opacity: 0;\n  transform: translateY(6px);\n  animation: choiceFlyIn 0.35s forwards;\n}\n.stardust-line {\n  text-align: center;\n  font-size: 14px;\n  color: var(--t-mute);\n  margin: 0 0 10px 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n}\n.stardust-line span {\n  display: inline-block;\n  animation: twinkleSoft ease-in-out infinite;\n}\n.stardust-line .dust-left { animation-duration: 2.1s; animation-delay: 0s; }\n.stardust-line .dust-core { animation-duration: 2.8s; animation-delay: 0.45s; font-size: 1.1em; }\n.stardust-line .dust-right { animation-duration: 2.4s; animation-delay: 0.9s; }\n.poem-casket {\n  position: relative;\n  margin-bottom: 12px;\n  padding: 8px 12px;\n  border-radius: 20px;\n  background: color-mix(in srgb, var(--t-main) 5%, transparent);\n  border: 1px solid var(--t-line);\n  transition: border 0.2s ease;\n}\n.poem-casket:hover { border-color: var(--t-mute); }\n.poem-text {\n  font-family: \"STSong\", \"Songti SC\", \"Noto Serif SC\", serif;\n  font-size: 12px;\n  line-height: 1.55;\n  text-align: center;\n  letter-spacing: 0.04em;\n  color: var(--t-dim);\n  white-space: pre-wrap;\n}\n.music-vessel {\n  position: relative;\n  border-radius: 24px;\n  border: 1px solid var(--t-line);\n  padding: 12px 12px 10px;\n  background: color-mix(in srgb, var(--t-main) 4%, transparent);\n  transition: border-color 0.2s;\n}\n.music-vessel:hover { border-color: var(--t-mute); }\n.disc-row {\n  display: grid;\n  grid-template-columns: 56px minmax(0, 1fr) 44px;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 12px;\n}\n.vinyl-star {\n  position: relative;\n  width: 56px;\n  height: 56px;\n  border-radius: 50%;\n  background: radial-gradient(circle at 30% 30%, rgba(255,255,240,0.2), color-mix(in srgb, var(--t-main) 12%, transparent) 70%);\n  box-shadow: 0 0 0 1px var(--t-line), 0 0 0 3px color-mix(in srgb, var(--t-main) 6%, transparent);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.vinyl-star.spinning { animation: vinylSpin 5s linear infinite; }\n.cover-mini {\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  overflow: hidden;\n  background: color-mix(in srgb, var(--t-main) 8%, transparent);\n  border: 1px solid var(--t-line);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.cover-mini img { width: 100%; height: 100%; object-fit: cover; }\n.cover-mini .no-cover { font-size: 12px; color: var(--t-mute); }\n.song-aura { min-width: 0; }\n.song-label {\n  font-size: 9px;\n  letter-spacing: 0.2em;\n  color: var(--t-mute);\n  margin-bottom: 4px;\n  text-transform: uppercase;\n}\n.song-title {\n  font-size: 14px;\n  font-weight: 500;\n  color: var(--t-dim);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.song-artist {\n  font-size: 11px;\n  color: var(--t-mute);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  margin-top: 2px;\n}\n.equalizer {\n  display: flex;\n  align-items: end;\n  gap: 3px;\n  height: 16px;\n  margin-top: 5px;\n  opacity: 0.5;\n}\n.equalizer i {\n  display: block;\n  width: 2.5px;\n  background: var(--t-dim);\n  border-radius: 2px;\n}\n.starry-player.is-playing .equalizer { opacity: 0.9; }\n.starry-player.is-playing .equalizer i { animation: equalizeWave 0.65s ease-in-out infinite; }\n.starry-player.is-playing .equalizer i:nth-child(2) { animation-duration: 0.55s; animation-delay: -0.15s; }\n.starry-player.is-playing .equalizer i:nth-child(3) { animation-duration: 0.7s; animation-delay: -0.3s; }\n.starry-player.is-playing .equalizer i:nth-child(4) { animation-duration: 0.5s; animation-delay: -0.1s; }\n.starry-player.is-playing .equalizer i:nth-child(5) { animation-duration: 0.8s; animation-delay: -0.25s; }\n.play-star-btn {\n  justify-self: center;\n  width: 42px;\n  height: 42px;\n  border-radius: 999px;\n  background: color-mix(in srgb, var(--t-main) 6%, transparent);\n  border: 1px solid var(--t-line);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  color: var(--t-mute);\n  transition: all 0.2s ease;\n}\n.play-star-btn:hover {\n  transform: scale(1.05);\n  border-color: var(--t-main);\n  color: var(--t-main);\n}\n.play-star-btn svg { width: 18px; height: 18px; fill: currentColor; }\n.control-bar {\n  display: grid;\n  grid-template-columns: 36px minmax(0, 1fr) 36px;\n  align-items: center;\n  gap: 8px;\n  margin-top: 8px;\n  margin-bottom: 6px;\n}\n.time-stamp {\n  font-size: 10px;\n  font-variant-numeric: tabular-nums;\n  color: var(--t-mute);\n  text-align: center;\n}\n.slider-starry {\n  width: 100%;\n  height: 16px;\n  background: transparent;\n  -webkit-appearance: none;\n  appearance: none;\n  cursor: pointer;\n}\n.slider-starry::-webkit-slider-runnable-track {\n  height: 4px;\n  border-radius: 4px;\n  background: color-mix(in srgb, var(--t-main) 30%, transparent);\n}\n.slider-starry::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  width: 12px;\n  height: 12px;\n  margin-top: -4px;\n  border-radius: 50%;\n  background: var(--t-main);\n  border: 1px solid color-mix(in srgb, var(--t-main) 40%, white);\n  box-shadow: 0 0 5px var(--t-main);\n  cursor: pointer;\n}\n.slider-starry::-webkit-slider-thumb:hover { transform: scale(1.15); }\n.js-progress {\n  background: linear-gradient(90deg, var(--t-main) 0%, var(--t-main) var(--progress-percent,0%), color-mix(in srgb, var(--t-main) 25%, transparent) var(--progress-percent,0%));\n  background-repeat: no-repeat;\n}\n.volume-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin-top: 8px;\n  padding-top: 4px;\n}\n.volume-icon {\n  font-size: 11px;\n  letter-spacing: 1px;\n  color: var(--t-mute);\n  min-width: 28px;\n}\n.volume-slider { flex: 1; }\n.volume-slider::-webkit-slider-runnable-track { background: color-mix(in srgb, var(--t-main) 40%, transparent); height: 4px; }\n.status-badge {\n  background: color-mix(in srgb, var(--t-main) 5%, transparent);\n  border-radius: 40px;\n  padding: 2px 8px;\n  font-size: 9px;\n  color: var(--t-mute);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  max-width: 105px;\n  text-align: center;\n  border: 0.5px solid var(--t-line);\n}\n.hidden-data { display: none !important; }\n@media (max-width: 600px) {\n  body { padding: 4px 8px; }\n  .player-head { min-height: 36px; padding: 7px 13px; grid-template-columns: 28px minmax(0,1fr) 28px; }\n  .player-title { font-size: 12px; }\n  .disc-row { grid-template-columns: 48px minmax(0,1fr) 38px; gap: 8px; }\n  .vinyl-star { width: 48px; height: 48px; }\n  .cover-mini { width: 38px; height: 38px; }\n  .play-star-btn { width: 36px; height: 36px; }\n  .play-star-btn svg { width: 16px; height: 16px; }\n  .song-title { font-size: 13px; }\n  .slider-starry { height: 14px; }\n}\n</style>\n</head>\n<body>\n<details class=\"starry-player\" open>\n  <summary class=\"player-head\">\n    <span class=\"player-balance\"></span>\n    <span class=\"player-title-box\">\n      <span class=\"player-title\">⊹ 星夜聆音 ⊹</span>\n    </span>\n    <span class=\"player-arrow\"></span>\n  </summary>\n  <div class=\"player-body\">\n    <div class=\"hidden-data\" data-poem=\"$1\"></div>\n    <div class=\"hidden-data\" data-song=\"$2\"></div>\n    <div class=\"stardust-line\">\n      <span class=\"dust-left\">·</span>\n      <span class=\"dust-core\">⊹</span>\n      <span class=\"dust-right\">·</span>\n    </div>\n    <div class=\"poem-casket\">\n      <div class=\"poem-text js-poem-display\">夜风微澜，星河低垂</div>\n    </div>\n    <div class=\"music-vessel\">\n      <div class=\"disc-row\">\n        <div class=\"vinyl-star js-vinyl\">\n          <div class=\"cover-mini js-cover-mini\"><div class=\"no-cover\">✨</div></div>\n        </div>\n        <div class=\"song-aura\">\n          <div class=\"song-label\">✦ 此刻聆听 ✦</div>\n          <div class=\"song-title js-track-title\">星尘摇篮曲</div>\n          <div class=\"song-artist js-track-artist\">未知星域</div>\n          <div class=\"equalizer\"><i></i><i></i><i></i><i></i><i></i></div>\n        </div>\n        <button type=\"button\" class=\"play-star-btn js-play-btn\">\n          <svg class=\"play-icon\" viewBox=\"0 0 24 24\"><polygon points=\"8,5 19,12 8,19\" fill=\"currentColor\"></polygon></svg>\n          <svg class=\"pause-icon\" viewBox=\"0 0 24 24\" style=\"display:none\"><path d=\"M6 4h4v16H6V4zm8 0h4v16h-4V4z\" fill=\"currentColor\"></path></svg>\n        </button>\n      </div>\n      <div class=\"control-bar\">\n        <span class=\"time-stamp js-current-time\">0:00</span>\n        <input type=\"range\" class=\"slider-starry js-progress\" min=\"0\" max=\"100\" value=\"0\">\n        <span class=\"time-stamp js-duration\">0:00</span>\n      </div>\n      <div class=\"volume-row\">\n        <span class=\"volume-icon\">⊹ VOL</span>\n        <input type=\"range\" class=\"slider-starry volume-slider js-volume\" min=\"0\" max=\"1\" step=\"0.02\" value=\"0.7\">\n        <div class=\"status-badge js-status-message\">✨ 待奏 ✨</div>\n      </div>\n    </div>\n    <audio class=\"js-audio-player\" preload=\"metadata\"></audio>\n  </div>\n</details>\n<script>\n(function(){\n  // ---------- 辅助函数 ----------\n  function getHiddenData(attr) {\n    var el = document.querySelector('.hidden-data[' + attr + ']');\n    if (!el) return '';\n    var val = el.getAttribute(attr);\n    return (val && !val.startsWith('$')) ? val.trim() : '';\n  }\n\n  // ---------- 主题同步（与父窗口颜色联动） ----------\n  function syncTheme() {\n    try {\n      var w = window.parent || window;\n      var d = w.document;\n      var root = d.documentElement;\n      var body = d.body;\n      var chatEl = d.querySelector('.mes_text') || d.querySelector('#chat') || body;\n      var styles = w.getComputedStyle(root);\n      var chatStyles = w.getComputedStyle(chatEl || body);\n      var bodyStyles = w.getComputedStyle(body || root);\n      var textColor = styles.getPropertyValue('--SmartThemeTextColor').trim();\n      if (!textColor || textColor.indexOf('var(') === 0) {\n        textColor = (chatStyles && chatStyles.color) || (bodyStyles && bodyStyles.color);\n      }\n      document.querySelectorAll('.starry-player').forEach(function(el) {\n        if (textColor && textColor.indexOf('var(') !== 0) {\n          el.style.setProperty('--st-text', textColor);\n        }\n        var ff = (chatStyles && chatStyles.fontFamily) || (bodyStyles && bodyStyles.fontFamily);\n        if (ff) el.style.fontFamily = ff;\n        var fw = styles.getPropertyValue('--mainFontWeight').trim() || (chatStyles && chatStyles.fontWeight) || (bodyStyles && bodyStyles.fontWeight);\n        if (fw) el.style.fontWeight = fw;\n        var fs = styles.getPropertyValue('--mainFontSize').trim() || (chatStyles && chatStyles.fontSize) || (bodyStyles && bodyStyles.fontSize);\n        if (fs) el.style.fontSize = fs;\n      });\n    } catch(e) {}\n  }\n\n  // ---------- iframe 高度自适应 ----------\n  function resizeFrame() {\n    try { var f = window.frameElement; if (f) f.style.height = document.body.scrollHeight + 'px'; } catch(e) {}\n  }\n\n  // ---------- DOM 元素绑定 ----------\n  var container = document.querySelector('.starry-player');\n  var poemDisplay = document.querySelector('.js-poem-display');\n  var trackTitleSpan = document.querySelector('.js-track-title');\n  var trackArtistSpan = document.querySelector('.js-track-artist');\n  var coverMiniDiv = document.querySelector('.js-cover-mini');\n  var vinylDisc = document.querySelector('.js-vinyl');\n  var playBtn = document.querySelector('.js-play-btn');\n  var playIconSvg = document.querySelector('.play-icon');\n  var pauseIconSvg = document.querySelector('.pause-icon');\n  var progressSlider = document.querySelector('.js-progress');\n  var currentTimeSpan = document.querySelector('.js-current-time');\n  var durationSpan = document.querySelector('.js-duration');\n  var volumeSlider = document.querySelector('.js-volume');\n  var statusSpan = document.querySelector('.js-status-message');\n  var audio = document.querySelector('.js-audio-player');\n\n  // ---------- 初始化显示内容 ----------\n  var rawPoem = getHiddenData('data-poem');\n  var rawSongName = getHiddenData('data-song');\n  if (rawPoem) poemDisplay.textContent = rawPoem;\n  else poemDisplay.textContent = '⋆ 星河入梦，弦月如钩 ⋆';\n  if (!rawSongName) rawSongName = 'Stardust Melody';\n  trackTitleSpan.textContent = rawSongName;\n  trackArtistSpan.textContent = '搜索中 · 星轨';\n\n  // ---------- 音乐播放核心（完整保留原有搜索逻辑） ----------\n  var songData = null;\n  var isPlaying = false;\n  var isSearching = false;\n\n  function setStatus(msg) { if (statusSpan) statusSpan.textContent = msg; }\n  function setPlayingUI(flag) {\n    i