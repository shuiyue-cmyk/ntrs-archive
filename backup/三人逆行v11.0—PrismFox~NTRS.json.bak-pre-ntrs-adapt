                "replaceString": "<style>\n/* MODULE: CSS_THEME */\n.jdg{color-scheme:dark light;--st-text:currentColor;--t-main:var(--st-text);--t-dim:color-mix(in srgb,var(--st-text) 76%,transparent);--t-mute:color-mix(in srgb,var(--st-text) 48%,transparent);--t-line:color-mix(in srgb,var(--st-text) 26%,transparent);--tr:.4s cubic-bezier(.33,1,.68,1);--rotate:-.5deg;color:inherit;font-family:inherit;font-weight:400;margin:8px 0;border:none;background:none;padding:0}\n\n/* MODULE: CSS_MARKER */\n.jdg summary.jdg-summary::-webkit-details-marker,.jdg summary.jdg-summary::marker{display:none;content:''}\n\n/* MODULE: CSS_SUMMARY */\n.jdg-summary{display:flex;align-items:center;justify-content:center;gap:7px;padding:6px 0;cursor:pointer;user-select:none;list-style:none;outline:none;color:var(--t-dim);font-weight:400;transition:all var(--tr);transform:rotate(var(--rotate));transform-origin:center center}.jdg-summary:hover{transform:rotate(0deg);color:var(--t-main)}\n\n/* MODULE: CSS_TITLE_PARTS - 基础月亮/星星样式 */\n.jdg-flower-moon,\n.jdg-flower-star {\n  font-size: 10px;\n  color: currentColor;\n  opacity: 0.5;\n  transition: all var(--tr);\n  animation-name: twinkle;\n  animation-timing-function: ease-in-out;\n  animation-iteration-count: infinite;\n}\n\n/* 悬停时所有月亮和星星停止动画，常亮 */\n.jdg-summary:hover .jdg-flower-moon,\n.jdg-summary:hover .jdg-flower-star {\n  animation: none;\n  opacity: 1;\n  color: var(--t-main);\n}\n\n.jdg-line{display:inline-block;width:20px;height:1px;background:currentColor;opacity:.35;transition:all var(--tr)}.jdg-summary:hover .jdg-line{width:48px;opacity:.65;background:var(--t-main)}.jdg-title-core{font-family:inherit;font-size:12px;letter-spacing:2.4px;white-space:nowrap;color:currentColor;font-weight:400;transition:all var(--tr)}.jdg-summary:hover .jdg-title-core{letter-spacing:3px;text-shadow:0 0 8px color-mix(in srgb,var(--t-main) 20%,transparent)}\n\n/* MODULE: CSS_BODY*/\n.jdg-body{padding:2px 0 0;color:var(--t-dim);font-weight:400}.jdg-raw{dis