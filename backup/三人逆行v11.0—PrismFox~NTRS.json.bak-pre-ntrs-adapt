e if (tr) tr('/setinput ' + text);\n  } catch (e) {}\n}\nfunction parseOptions(raw) {\n  var cleaned = String(raw || '')\n    .replace(/<\\/?(?:details|summary|branches)[^>]*>/gi, '\\n')\n    .replace(/🧩\\s*Select/gi, '\\n');\n  var opts = [];\n  var seen = {};\n  cleaned.split(/\\r?\\n/).forEach(function(line) {\n    var m = line.match(/^\\s*(?:[*_#>\\-]+\\s*)?[（(【\\[]?([A-Ja-j])[）)】\\]]?\\s*[\\.\\uFF0E、,，:：\\-—]\\s*(.*\\S)\\s*$/);\n    if (!m) return;\n    var letter = m[1].toUpperCase();\n    if (seen[letter]) return;\n    var text = m[2].replace(/\\*\\*/g, '').replace(/\\s+/g, ' ').trim();\n    if (!text) return;\n    seen[letter] = true;\n    opts.push({ letter: letter, text: text });\n  });\n  return opts;\n}\nfunction buildItems() {\n  var ta = document.getElementById('branches-raw');\n  var raw = ta ? ta.value : '';\n  var box = document.getElementById('choice-options');\n  if (!box) return;\n  var opts = parseOptions(raw);\n  if (!opts.length) {\n    var fb = document.createElement('div');\n    fb.className = 'choice-fallback';\n    fb.textContent = String(raw || '').replace(/<\\/?(?:details|summary|branches)[^>]*>/gi, '').trim() || '（未解析到选项）';\n    box.appendChild(fb);\n    return;\n  }\n  opts.forEach(function(o, i) {\n    var btn = document.createElement('button');\n    btn.type = 'button';\n    btn.className = 'choice-item';\n    btn.style.animationDelay = (i * 0.08).toFixed(2) + 's';\n    btn.innerHTML = '<span class=\"choice-letter\"><svg class=\"choice-orbit\" viewBox=\"0 0 36 36\"><g transform=\"translate(18,18)\"><path class=\"orbit-ring\" d=\"M0,-15 A15,15 0 1,1 -15,0\"/><text class=\"orbit-char\" x=\"-11\" y=\"-11\" fill=\"currentColor\">⊹</text></g></svg><i class=\"lt\"></i></span><span class=\"choice-text\"></span><svg class=\"choice-meteor\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 20 L16 8\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/><circle cx=\"4\" cy=\"20\" r=\"1.8\" fill=\"currentColor\"/><circle cx=\"16\" cy=\"8\" r=\"1\" fill=\"currentColor\"/></svg>';\n    btn.querySelector('.lt').textContent = o.letter;\n    btn.querySelector('.choice-text').textContent = o.text;\n    btn.addEventListener('click', function() { injectChoice(o.text); });\n    box.appendChild(btn);\n  });\n}\nfunction syncTheme() {\n  try {\n    var w = window.parent || window;\n    var d = w.document;\n    var root = d.documentElement;\n    var body = d.body;\n    var chatEl = d.querySelector('.mes_text') || d.querySelector('#chat') || body;\n    var styles = w.getComputedStyle(root);\n    var chatStyles = w.getComputedStyle(chatEl || body);\n    var bodyStyles = w.getComputedStyle(body || root);\n    var textColor = styles.getPropertyValue('--SmartThemeTextColor').trim();\n    if (!textColor || textColor.indexOf('var(') === 0) textColor = (chatStyles && chatStyles.color) || (bodyStyles && bodyStyles.color);\n    document.querySelectorAll('.choice-wrap').forEach(function(el) {\n      if (textColor && textColor.indexOf('var(') !== 0) el.style.setProperty('--st-text', textColor);\n      var ff = (chatStyles && chatStyles.fontFamily) || (bodyStyles && bodyStyles.fontFamily);\n      if (ff) el.style.fontFamily = ff;\n      var fw = styles.getPropertyValue('--mainFontWeight').trim() || (chatStyles && chatStyles.fontWeight) || (bodyStyles && bodyStyles.fontWeight);\n      if (fw) el.style.fontWeight = fw;\n      var fs = styles.getPropertyValue('--mainFontSize').trim() || (chatStyles && chatStyles.fontSize) || (bodyStyles && bodyStyles.fontSize);\n      if (fs) el.style.fontSize = fs;\n    });\n  } catch (e) {}\n}\nfunction resizeFrame() { try { var f = window.frameElement; if (f) f.style.height = document.body.scrollHeight + 'px'; } catch(e) {} }\ndocument.addEventListener('DOMContentLoaded', function() {\n  buildItems();\n  syncTheme();\n  try {\n    var w = window.parent, d = w.document;\n    if (d && window.MutationObserver) {\n      var observer = new MutationObserver(syncTheme);\n      observer.